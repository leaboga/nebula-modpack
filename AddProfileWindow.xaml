<Window x:Class="KrakenLauncher.AddProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NUEVA EXPEDICIÓN" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#05080D" WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False">
    
    <Border BorderBrush="#1E2C38" BorderThickness="1" CornerRadius="16" Background="#0A0E14">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="CONFIGURAR PERFIL" Foreground="White" FontSize="20" FontWeight="Black"/>
                <TextBlock Text="Define los parámetros de tu nueva instancia" Foreground="#344A5B" FontSize="11" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="NOMBRE DEL PERFIL" Foreground="#6D8A99" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="ProfileName" Style="{DynamicResource AppleTextBox}" Text="Nueva Instancia" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="VERSIÓN MC" Foreground="#6D8A99" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="VersionCombo" Style="{DynamicResource ModernComboBox}" Height="40">
                            <ComboBoxItem Content="1.20.1" IsSelected="True"/>
                            <ComboBoxItem Content="1.21.1"/>
                            <ComboBoxItem Content="1.19.2"/>
                            <ComboBoxItem Content="1.18.2"/>
                            <ComboBoxItem Content="1.16.5"/>
                            <ComboBoxItem Content="1.8.9"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="MOTOR (LOADER)" Foreground="#6D8A99" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="LoaderCombo" Style="{DynamicResource ModernComboBox}" Height="40">
                            <ComboBoxItem Content="Vanilla" Tag="vanilla" IsSelected="True"/>
                            <ComboBoxItem Content="Fabric" Tag="fabric"/>
                            <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                            <ComboBoxItem Content="Forge" Tag="forge"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCELAR" Style="{DynamicResource SecondaryButton}" Width="100" Height="40" Margin="0,0,12,0" Click="Cancel_Click"/>
                <Button Content="CREAR PERFIL" Style="{DynamicResource PlayButton}" Width="140" Height="40" Click="Create_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
