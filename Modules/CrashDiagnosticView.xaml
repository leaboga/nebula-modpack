<UserControl x:Class="NebulaLauncher.Modules.CrashDiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="800"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Diagnóstico Nebula" Foreground="White" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Historial de errores y salud del modpack" Foreground="#6D8A99" FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#0A0E14" CornerRadius="16" Padding="40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLabel" Text="✓ Sistema Saludable" Foreground="#10B981" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DetailLabel" Text="No se detectaron crashes recientes en esta instancia." Foreground="#6D8A99" FontSize="13" Margin="0,10,0,30" HorizontalAlignment="Center"/>
                <Button Content="Análisis Profundo" Style="{StaticResource SecondaryButton}" Width="160" Height="40" Click="Analyze_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
