<UserControl x:Class="NebulaLauncher.Modules.CrashDiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Diagnostico KRAKEN" Foreground="White" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Historial de errores, reporte rapido y acceso a logs" Foreground="#6D8A99" FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#0A0E14" CornerRadius="16" Padding="40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLabel" Text="Sistema saludable" Foreground="#10B981" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DetailLabel" Text="No se detectaron crashes recientes en esta instancia." Foreground="#6D8A99" FontSize="13" Margin="0,10,0,30" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Analisis profundo" Style="{StaticResource SecondaryButton}" Width="160" Height="40" Click="Analyze_Click"/>
                    <Button Content="Exportar reporte" Style="{StaticResource SecondaryButton}" Width="160" Height="40" Margin="12,0,0,0" Click="ExportReport_Click"/>
                    <Button Content="Abrir logs" Style="{StaticResource SecondaryButton}" Width="120" Height="40" Margin="12,0,0,0" Click="OpenLogs_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="Estado de update" Style="{StaticResource SecondaryButton}" Width="160" Height="40" Click="OpenUpdateState_Click"/>
                    <Button Content="Log del updater" Style="{StaticResource SecondaryButton}" Width="160" Height="40" Margin="12,0,0,0" Click="OpenUpdaterLog_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
