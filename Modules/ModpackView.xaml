<UserControl x:Class="NebulaLauncher.Modules.ModpackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ModpackCard" TargetType="Border">
            <Setter Property="Background" Value="#1A1528"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#2E2648"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="340"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📦 MODPACK HUB" Foreground="White" FontSize="26" FontWeight="Black"/>
                <Border Background="#2010B981" CornerRadius="8" Padding="12,4" Margin="20,0,0,0">
                    <TextBlock Text="MODRINTH COMPATIBLE" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Background="#1A1528" CornerRadius="12" Width="250" BorderBrush="#2E2648" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" Padding="14,8,40,8" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>
                        <Button HorizontalAlignment="Right" Content="🔍" Background="Transparent" BorderThickness="0" Foreground="#7B6FA0" Width="40" Click="BtnSearch_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ModpackList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ModpackCard}">
                            <Grid Margin="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Border Width="100" Height="100" CornerRadius="20" Background="#161125">
                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                </Border>
                                
                                <StackPanel Grid.Row="1" Margin="0,15,0,0">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="45"/>
                                    <TextBlock Text="{Binding Author}" Foreground="#6EE7B7" FontSize="11" HorizontalAlignment="Center" Margin="0,4"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#7B6FA0" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="40" Opacity="0.8"/>
                                </StackPanel>
                                
                                <Button Grid.Row="2" Content="⚡ INSTALAR COMO PERFIL" Style="{DynamicResource PlayButton}" Height="38" Click="BtnInstall_Click" Tag="{Binding ProjectId}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#DD0A0714" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText" Text="Descargando Modpack..." Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <ProgressBar x:Name="InstallProgress" Width="300" Height="6" Style="{DynamicResource AppleProgress}"/>
                <TextBlock x:Name="StatusLabel" Text="Iniciando motores galácticos..." Foreground="#7B6FA0" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
