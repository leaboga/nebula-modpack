<UserControl x:Class="NebulaLauncher.Modules.ModpackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ModpackCard" TargetType="Border">
            <Setter Property="Background" Value="#0D151D"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#1E2C38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="340"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,36,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="Central de Modpacks"
                       Foreground="#E6F9FF" FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="NÚCLEO DE PERFILES GALÁCTICOS"
                       Foreground="#1C2D3A" FontSize="9" FontWeight="Bold"/>
        </StackPanel>

        <!-- Search / Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="SearchBox" Width="250" Style="{DynamicResource SearchTextBox}" Tag="Explorar expediciones..." KeyDown="SearchBox_KeyDown"/>
            </StackPanel>
        </Grid>

        <!-- CUERPO -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR FILTERS -->
            <Border Grid.Column="0" Margin="0,0,16,0" Background="#0D0A1ACC" CornerRadius="22" BorderBrush="#1E2C38" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="VERSION" Foreground="#344A5B" FontSize="10" FontWeight="Black" Margin="4,0,0,10"/>
                        <ComboBox x:Name="FilterVersion" Style="{DynamicResource ModernComboBox}" Margin="0,0,0,20" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Todas las versiones" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="1.21" Tag="1.21"/>
                            <ComboBoxItem Content="1.20.1" Tag="1.20.1"/>
                            <ComboBoxItem Content="1.19.2" Tag="1.19.2"/>
                            <ComboBoxItem Content="1.18.2" Tag="1.18.2"/>
                            <ComboBoxItem Content="1.16.5" Tag="1.16.5"/>
                        </ComboBox>

                        <TextBlock Text="LOADER" Foreground="#344A5B" FontSize="10" FontWeight="Black" Margin="4,0,0,10"/>
                        <ComboBox x:Name="FilterLoader" Style="{DynamicResource ModernComboBox}" Margin="0,0,0,20" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Cualquier Loader" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Fabric" Tag="fabric"/>
                            <ComboBoxItem Content="Forge" Tag="forge"/>
                            <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                            <ComboBoxItem Content="Quilt" Tag="quilt"/>
                        </ComboBox>

                        <TextBlock Text="CATEGORÍAS" Foreground="#344A5B" FontSize="10" FontWeight="Black" Margin="4,0,0,10"/>
                        <ListBox x:Name="FilterCategory" Background="Transparent" BorderThickness="0" SelectionChanged="Filter_Changed">
                            <ListBoxItem IsSelected="True" Tag="all"><TextBlock Text="🌌 Todos"/></ListBoxItem>
                            <ListBoxItem Tag="adventure"><TextBlock Text="🧗 Aventura"/></ListBoxItem>
                            <ListBoxItem Tag="exploration"><TextBlock Text="🗺️ Exploración"/></ListBoxItem>
                            <ListBoxItem Tag="tech"><TextBlock Text="🤖 Tecnología"/></ListBoxItem>
                            <ListBoxItem Tag="magic"><TextBlock Text="🔮 Magia"/></ListBoxItem>
                            <ListBoxItem Tag="quest"><TextBlock Text="📜 Misiones"/></ListBoxItem>
                            <ListBoxItem Tag="hardcore"><TextBlock Text="💀 Hardcore"/></ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RESULTADOS -->
            <Border Grid.Column="1" Background="#05080D" CornerRadius="22" BorderBrush="#1E2C38" BorderThickness="1" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ModpackList" Margin="10">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                     <DataTemplate>
                                         <Border Style="{DynamicResource GlassCard}" Margin="12" Width="260" Height="380" ClipToBounds="True">
                                             <Grid Margin="18">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto"/>
                                                     <RowDefinition Height="*"/>
                                                     <RowDefinition Height="Auto"/>
                                                 </Grid.RowDefinitions>
                                                 
                                                 <Border Width="110" Height="110" CornerRadius="28" Background="#05080D" BorderBrush="#1E2C38" BorderThickness="1" HorizontalAlignment="Center">
                                                     <Grid>
                                                         <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.15"/>
                                                         <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                     </Grid>
                                                 </Border>
                                                 
                                                 <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                                     <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="52"/>
                                                     <TextBlock Text="{Binding Author}" Foreground="#70F9FF" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                                     
                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                                         <Border Background="#1A00F2FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                             <TextBlock Text="{Binding DisplayDownloads}" Foreground="#00F2FF" FontSize="9" FontWeight="Bold"/>
                                                         </Border>
                                                     </StackPanel>

                                                     <TextBlock Text="{Binding Description}" Foreground="#6D8A99" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="45" Opacity="0.7" Margin="0,8,0,0"/>
                                                 </StackPanel>
                                                 
                                                 <Button Grid.Row="2" Content="⚡ INSTALAR COMO PERFIL" Style="{DynamicResource PlayButton}" Height="42" Click="BtnInstall_Click" Tag="{Binding ProjectId}"/>
                                             </Grid>
                                         </Border>
                                     </DataTemplate>
                                 </ItemsControl.ItemTemplate>
            </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#DD0A0714" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText" Text="Descargando Modpack..." Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <ProgressBar x:Name="InstallProgress" Width="300" Height="6" Style="{DynamicResource AppleProgress}"/>
                <TextBlock x:Name="StatusLabel" Text="Iniciando motores galácticos..." Foreground="#6D8A99" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
