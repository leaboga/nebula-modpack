<UserControl x:Class="NebulaLauncher.Modules.ScreenshotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </UserControl.Resources>
    
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0714" Offset="0"/>
            <GradientStop Color="#0F0B1A" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Capturas de Pantalla" Foreground="White" FontSize="24" FontWeight="ExtraBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="CountLabel" Text="RECUERDOS DE TU VIAJE GALÁCTICO" Foreground="#4A4266" FontSize="10" FontWeight="Bold"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="OpenFolderBtn" Content="📁 Abrir Carpeta" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" Click="OpenFolderBtn_Click"/>
                <Button x:Name="RefreshBtn" Content="🔄" Style="{StaticResource SecondaryButton}" Height="36" Width="38" Margin="8,0,0,0" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Gallery -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,100,0,0" Visibility="Collapsed">
                    <TextBlock Text="📷" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.5"/>
                    <TextBlock Text="No hay capturas todavía" Foreground="#7B6FA0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Presioná F2 en el juego para capturar un momento." Foreground="#3D3560" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                
                <WrapPanel x:Name="GalleryPanel" HorizontalAlignment="Left"/>
            </Grid>
        </ScrollViewer>

        <!-- Full-screen Overlay -->
        <Grid x:Name="FullscreenOverlay" Grid.RowSpan="2" Background="#F2000000" Visibility="Collapsed" MouseDown="FullscreenOverlay_MouseDown">
            <Grid.Effect>
                <BlurEffect Radius="0"/>
            </Grid.Effect>
            
            <Image x:Name="FullscreenImage" Stretch="Uniform" Margin="60">
                <Image.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="50" ShadowDepth="0"/>
                </Image.Effect>
            </Image>
            
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#1A1528" CornerRadius="12" Padding="20,12" Margin="0,0,0,40" BorderBrush="#2E2648" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="FullscreenLabel" Foreground="White" FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Click para cerrar • Click derecho para abrir en carpeta" Foreground="#4A4266" FontSize="10" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" Background="Transparent" Foreground="#4A4266" BorderThickness="0" FontSize="28" Cursor="Hand" Click="RefreshBtn_Click"/>
        </Grid>
    </Grid>
</UserControl>
