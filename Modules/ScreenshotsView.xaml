<UserControl x:Class="KrakenLauncher.Modules.ScreenshotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </UserControl.Resources>
    
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#05080D" Offset="0"/>
            <GradientStop Color="#05080D" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Capturas de Pantalla" Foreground="White" FontSize="24" FontWeight="ExtraBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="CountLabel" Text="RECUERDOS DE TU VIAJE GAL\u00C1CTICO" Foreground="#344A5B" FontSize="10" FontWeight="Bold"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="OpenFolderBtn" Content="\uD83D\uDCC1 Abrir Carpeta" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" Click="OpenFolderBtn_Click"/>
                <Button x:Name="RefreshBtn" Content="\uD83D\uDD04" Style="{StaticResource SecondaryButton}" Height="36" Width="38" Margin="8,0,0,0" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Gallery -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,100,0,0" Visibility="Collapsed">
                    <TextBlock Text="📷" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.5"/>
                    <TextBlock Text="No hay capturas todavía" Foreground="#6D8A99" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Presioná F2 en el juego para capturar un momento." Foreground="#1C2D3A" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                
                <WrapPanel x:Name="GalleryPanel" HorizontalAlignment="Left"/>
            </Grid>
        </ScrollViewer>

        <!-- Full-screen Overlay -->
        <Grid x:Name="FullscreenOverlay" Grid.RowSpan="2" Background="#F2000000" Visibility="Collapsed" MouseDown="FullscreenOverlay_MouseDown">
            <Grid.Effect>
                <BlurEffect Radius="0"/>
            </Grid.Effect>
            
            <Image x:Name="FullscreenImage" Stretch="Uniform" Margin="60">
                <Image.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="50" ShadowDepth="0"/>
                </Image.Effect>
            </Image>
            
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#0D151D" CornerRadius="12" Padding="20,12" Margin="0,0,0,40" BorderBrush="#1E2C38" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="FullscreenLabel" Foreground="White" FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,4">
                        <Button Content="\uD83D\uDCCB Copiar al Portapapeles" Style="{DynamicResource PlayButton}" Height="34" Padding="16,0" Click="BtnCopy_Click" Margin="0,0,8,0"/>
                        <Button Content="Ruta" Style="{DynamicResource SecondaryButton}" Height="34" Padding="16,0" Click="BtnCopyPath_Click" Margin="0,0,8,0"/>
                        <Button Content="\uD83D\uDCC1 Ver en Carpeta" Style="{DynamicResource SecondaryButton}" Height="34" Padding="16,0" Click="BtnOpenInFolder_Click"/>
                        <Button Content="Eliminar" Style="{DynamicResource SecondaryButton}" Height="34" Padding="16,0" Margin="8,0,0,0" Click="BtnDelete_Click"/>
                    </StackPanel>
                    <TextBlock Text="Click para cerrar" Foreground="#344A5B" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" Background="Transparent" Foreground="#344A5B" BorderThickness="0" FontSize="28" Cursor="Hand" Click="RefreshBtn_Click"/>
        </Grid>
    </Grid>
</UserControl>
