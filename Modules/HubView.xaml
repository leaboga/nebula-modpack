<UserControl x:Class="KrakenLauncher.Modules.HubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dynamic Tab Bar -->
        <Border Grid.Row="0" Margin="32,0,32,0" BorderBrush="#1E2C38" BorderThickness="0,0,0,1">
            <StackPanel x:Name="TabContainer" Orientation="Horizontal"/>
        </Border>

        <!-- Content Area -->
        <ContentControl x:Name="ActiveModuleContainer" Grid.Row="1"/>
    </Grid>
</UserControl>
