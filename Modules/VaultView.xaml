<UserControl x:Class="NebulaLauncher.Modules.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="VaultView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid x:Name="VaultRoot">
        <Grid Margin="40,36,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,28">
                <TextBlock Text="Bóveda de Recursos"
                           Foreground="#E6F9FF" FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="SISTEMA DE EXPLORACIÓN MODRINTH"
                           Foreground="#1C2D3A" FontSize="9" FontWeight="Bold"/>
            </StackPanel>

            <!-- CONTROLS HEADER -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refrescar Manifiesto" Style="{DynamicResource SecondaryButton}" Height="34" Click="BtnRefresh_Click"/>
                    <CheckBox x:Name="FavoritesOnlyCheck" Content="Solo favoritos" Style="{DynamicResource TrayToggle}" VerticalAlignment="Center" Margin="14,0,0,0" Checked="FavoritesOnly_Changed" Unchecked="FavoritesOnly_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton x:Name="FilterMods" Content="Mods" IsChecked="True" Style="{DynamicResource ToggleTab}" Margin="0,0,8,0" Click="FilterType_Changed"/>
                    <RadioButton x:Name="FilterShaders" Content="Shaders" Style="{DynamicResource ToggleTab}" Margin="0,0,8,0" Click="FilterType_Changed"/>
                    <RadioButton x:Name="FilterResourcePacks" Content="Packs" Style="{DynamicResource ToggleTab}" Margin="0,0,16,0" Click="FilterType_Changed"/>
                    
                    <CheckBox x:Name="FilterInstalled" Content="Instalados" Style="{DynamicResource TrayToggle}" VerticalAlignment="Center" Margin="0,0,16,0" Checked="FilterInstalled_Changed" Unchecked="FilterInstalled_Changed"/>
                    
                    <TextBox x:Name="SearchBox" Width="220" Style="{DynamicResource SearchTextBox}" Height="36" Tag="Buscar en la bóveda..." KeyDown="SearchBox_KeyDown" Margin="12,0,0,0"/>
                    
                    <ComboBox x:Name="SortCombo" Width="140" Height="36" Style="{DynamicResource ModernComboBox}" Margin="12,0,0,0" SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="Relevancia" Tag="relevance" IsSelected="True"/>
                        <ComboBoxItem Content="Descargas" Tag="downloads"/>
                        <ComboBoxItem Content="Recientes" Tag="recent"/>
                        <ComboBoxItem Content="Favoritos" Tag="favorites"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- CUERPO -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Margin="0,0,16,0" Background="#0D0A1ACC" CornerRadius="22" BorderBrush="#1E2C38" BorderThickness="1">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="CATEGORÍAS" Foreground="#344A5B" FontSize="10" FontWeight="Black" Margin="4,0,0,12"/>
                            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" SelectionChanged="CategoryList_SelectionChanged">
                                <ListBoxItem IsSelected="True" Tag="all"><TextBlock Text="🌌 Todos"/></ListBoxItem>
                                <ListBoxItem Tag="optimization"><TextBlock Text="⚡ Optimización"/></ListBoxItem>
                                <ListBoxItem Tag="technology"><TextBlock Text="🤖 Tecnología"/></ListBoxItem>
                                <ListBoxItem Tag="magic"><TextBlock Text="🔮 Magia"/></ListBoxItem>
                                <ListBoxItem Tag="adventure"><TextBlock Text="🧗 Aventura"/></ListBoxItem>
                                <ListBoxItem Tag="quest"><TextBlock Text="📜 Misiones"/></ListBoxItem>
                                <ListBoxItem Tag="food"><TextBlock Text="🍎 Alimentos"/></ListBoxItem>
                                <ListBoxItem Tag="utility"><TextBlock Text="🛠️ Herramientas"/></ListBoxItem>
                            </ListBox>
                        </StackPanel>

                        <Border Grid.Row="2" Background="#05080D" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="MASA DE MODS" Foreground="#1C2D3A" FontSize="9" FontWeight="Black" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Local" Foreground="#6D8A99" FontSize="11"/>
                                    <TextBlock x:Name="TxtTotalWeight" Text="0 MB" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="WeightProgress" Height="4" Value="0" Maximum="1000" Style="{DynamicResource AppleProgress}" Margin="0,4"/>
                                <TextBlock x:Name="TxtWeightStatus" Text="Carga Óptima" Foreground="#10B981" FontSize="9" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- RESULTADOS -->
                <Border Grid.Column="1" Background="#05080D" CornerRadius="22" BorderBrush="#1E2C38" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <!-- FEEDBACK OVERLAYS -->
                        <ProgressBar x:Name="NebulaLoadingBar" VerticalAlignment="Top" Height="2" Style="{DynamicResource AppleProgress}" Visibility="Collapsed" Panel.ZIndex="10"/>

                        <ScrollViewer x:Name="SkeletonPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" Padding="14">
                            <WrapPanel HorizontalAlignment="Center">
                                <Border Width="250" Height="400" Style="{StaticResource SkeletonBlock}" Margin="12"/>
                                <Border Width="250" Height="400" Style="{StaticResource SkeletonBlock}" Margin="12"/>
                                <Border Width="250" Height="400" Style="{StaticResource SkeletonBlock}" Margin="12"/>
                            </WrapPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Padding="14">
                            <StackPanel>
                                <ItemsControl x:Name="ResultsList">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GlassCard}" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                                <Grid Margin="18">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    
                                                    <!-- Icon & Badge -->
                                                    <Grid>
                                                        <Button Content="{Binding FavoriteGlyph}" Tag="{Binding ProjectId}" Click="FavoriteBtn_Click" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource SecondaryButton}" FontSize="13" Padding="0" Margin="0,0,0,6"/>
                                                        <Border Width="90" Height="90" CornerRadius="24" Background="#05080D">
                                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="44"/>
                                                        <TextBlock Text="{Binding Author}" Foreground="#70F9FF" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                                        <TextBlock Text="{Binding MetadataLine}" Foreground="#6D8A99" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                        
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                                                            <Border Background="{Binding StatusBadgeBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusBadgeTextBrush}" FontSize="8" FontWeight="Black"/>
                                                            </Border>
                                                            <Border Background="#1A7C3AED" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="FAVORITO" Foreground="#C4B5FD" FontSize="8" FontWeight="Black"/>
                                                            </Border>
                                                            <Border Background="#1A60A5FA" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding IsRecent, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="RECIENTE" Foreground="#93C5FD" FontSize="8" FontWeight="Black"/>
                                                            </Border>
                                                            <Border Background="#1A10B981" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="COINCIDENCIA" Foreground="#10B981" FontSize="8" FontWeight="Black"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    
                                                    <Button Grid.Row="2" Content="{Binding ButtonLabel}" Style="{DynamicResource PlayButton}" Background="{Binding ButtonBrush}" Click="InstallBtn_Click" Tag="{Binding ProjectId}" Height="38" Margin="0,8,0,0" Visibility="{Binding ShowButton, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed">
                                    <Button Content="«" Style="{DynamicResource SecondaryButton}" Width="40" Click="BtnPrevPage_Click"/>
                                    <TextBlock x:Name="TxtPage" Text="Página 1" VerticalAlignment="Center" Margin="15,0" Foreground="White" FontWeight="Bold"/>
                                    <Button Content="»" Style="{DynamicResource SecondaryButton}" Width="40" Click="BtnNextPage_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="LocalScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                            <ItemsControl x:Name="LocalList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D151D" CornerRadius="12" Margin="0,0,0,10" Padding="16" BorderBrush="#1E2C38" BorderThickness="1">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SizeText}" Foreground="#6D8A99" FontSize="11"/>
                                                </StackPanel>
                                                <Button HorizontalAlignment="Right" Content="🗑️" Style="{DynamicResource SecondaryButton}" Tag="{Binding FilePath}" Click="DeleteFileBtn_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="🦑" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.3"/>
                            <TextBlock Text="EL ABISMO ESTÁ DESPEJADO" Foreground="White" FontSize="16" FontWeight="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="No se detectaron recursos con los parámetros actuales." Foreground="#344A5B" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <Button Content="Limpiar Filtros" Style="{DynamicResource SecondaryButton}" Margin="0,20,0,0" Width="140" Click="BtnRefresh_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FLYOUT -->
        <Border x:Name="DetailFlyout" Background="#05080D" BorderBrush="#1E2C38" BorderThickness="1,0,0,0" HorizontalAlignment="Right" Width="480" Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform X="480"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Button Margin="20" Content="✕" Style="{DynamicResource TitleBarButton}" Width="32" Click="CloseFlyout_Click" HorizontalAlignment="Left"/>
                <ScrollViewer Grid.Row="1" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Width="80" Height="80" CornerRadius="18" Background="#0D151D">
                                <Image x:Name="DetailIcon" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock x:Name="DetailTitle" Foreground="White" FontSize="22" FontWeight="Black" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailAuthor" Foreground="#70F9FF" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="#0D151D" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ANÁLISIS DE IMPACTO" Foreground="#6D8A99" FontSize="9" FontWeight="Black"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock x:Name="TxtImpactIcon" Text="🟢" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtModImpact" Text="Bajo" Foreground="#10B981" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtModWeightEstimate" Text="0 MB" Foreground="#344A5B" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="DetailDescription" Foreground="#D1D5DB" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
