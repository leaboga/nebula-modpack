<UserControl x:Class="NebulaLauncher.Modules.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Content Card Style -->
        <Style x:Key="ContentCard" TargetType="Border">
            <Setter Property="Background" Value="#110F1A"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#1E1A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="360"/>
            <Setter Property="Margin" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                    <Setter Property="Background" Value="#161421"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionBtn" TargetType="ButtonBase">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navbar / Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mod Hub" Foreground="White" FontSize="26" FontWeight="Black"/>
                <TextBlock Text="BUSCAR CONTENIDO EN MODRINTH" Foreground="#6B5E8A" FontSize="10" FontWeight="Bold" Margin="2,2,0,0"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <RadioButton x:Name="FilterMods" Content="📦 Mods" IsChecked="True" Checked="FilterType_Changed" Style="{StaticResource ToggleTab}" Margin="0,0,12,0" Padding="12,6"/>
                    <RadioButton x:Name="FilterShaders" Content="✨ Shaders" Checked="FilterType_Changed" Style="{StaticResource ToggleTab}" Margin="0,0,12,0" Padding="12,6"/>
                    <RadioButton x:Name="FilterResourcePacks" Content="🎨 Packs" Checked="FilterType_Changed" Style="{StaticResource ToggleTab}" Margin="0,0,12,0" Padding="12,6"/>
                    
                    <Border Width="1" Height="20" Background="#1E1A2E" Margin="12,0"/>
                    
                    <ToggleButton x:Name="FilterInstalled" Content="📂 Instalados" Style="{StaticResource ToggleTabButton}" 
                                  Checked="FilterInstalled_Changed" Unchecked="FilterInstalled_Changed" Padding="12,6" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <Border Background="#13111F" CornerRadius="12" BorderBrush="#1E1A2E" BorderThickness="1" Height="42" Width="280">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="14,0" 
                                 KeyDown="SearchBox_KeyDown" SelectionBrush="#7C3AED" FontSize="13" Tag="Buscar en la red..."/>
                        <Button Grid.Column="1" Content="🔍" Background="Transparent" BorderThickness="0" Foreground="#4A4266" FontSize="16" Width="40" Cursor="Hand" Click="BtnSearch_Click"/>
                    </Grid>
                </Border>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="BtnRefresh" Content="🔄 Refrescar" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Click="BtnRefresh_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnOpenFolder" Content="📂 Carpeta" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Click="BtnOpenFolder_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <Border Grid.Row="1" Background="#0D0B1899" CornerRadius="24" BorderBrush="#1E1A2E" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- Loading State -->
                <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="140" Height="4" Margin="0,0,0,16" Style="{StaticResource AppleProgress}"/>
                    <TextBlock x:Name="LoadingLabel" Text="Consultando Modrinth..." Foreground="#6B5E8A" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Results Grid -->
                <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Padding="16">
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ContentCard}">
                                    <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Width="90" Height="90" CornerRadius="20" Background="#161421" Margin="0,0,0,16" BorderBrush="#1E1A2E" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill">
                                                    <Image.OpacityMask>
                                                        <VisualBrush>
                                                            <VisualBrush.Visual>
                                                                <Border Background="Black" CornerRadius="20" Width="90" Height="90"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Image.OpacityMask>
                                                </Image>
                                                <Border Background="#10B981" CornerRadius="10" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-5,-5" Visibility="{Binding IsInstalledVisibility}">
                                                    <TextBlock Text="✓" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Author}" Foreground="#7C3AED" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#8B7BAF" FontSize="11" TextWrapping="Wrap" Height="50" TextTrimming="CharacterEllipsis" TextAlignment="Center" Opacity="0.7" Margin="0,8,0,0"/>
                                            
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.6">
                                                <TextBlock Text="📥 " FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DownloadsText}" Foreground="#C4B5FD" FontSize="10" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Row="2" Content="{Binding ButtonLabel}" Style="{StaticResource ActionBtn}" Background="{Binding ButtonColor}" 
                                                Click="InstallBtn_Click" Tag="{Binding ProjectId}" Height="40" Margin="0,14,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Installed Files View -->
                <ScrollViewer x:Name="LocalScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                    <ItemsControl x:Name="LocalList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#12101E" CornerRadius="14" Margin="0,0,0,10" Padding="18,12" BorderBrush="#1E1A2E" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SizeText}" Foreground="#4A4266" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📂 Ver" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Tag="{Binding FilePath}" Click="OpenFileBtn_Click" Margin="0,0,10,0"/>
                                            <Button Content="🗑️ Eliminar" Style="{StaticResource SecondaryButton}" Background="#2E1A1A" BorderBrush="#4A2A2A" Height="32" Padding="12,0" Tag="{Binding FilePath}" Click="DeleteFileBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyPanel" Text="Sin resultados galácticos" Foreground="#4A4266" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

