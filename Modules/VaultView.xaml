<UserControl x:Class="NebulaLauncher.Modules.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
        </Storyboard>

        <!-- Premium Content Card -->
        <Style x:Key="ContentCard" TargetType="Border">
            <Setter Property="Background" Value="#110F1A"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#1E1A2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="Height" Value="340"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#7C3AED88"/>
                    <Setter Property="Background" Value="#151121"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PremiumBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1A1528"/>
                                <Setter Property="Foreground" Value="#4A4266"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Hub Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mod Hub" Foreground="White" FontSize="28" FontWeight="Black" LetterSpacing="1"/>
                <TextBlock Text="RED GALÁCTICA DE CONTENIDO" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,2,0,0" CharacterSpacing="120"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <RadioButton x:Name="FilterMods" Content="📦 Mods" IsChecked="True" Checked="FilterType_Changed" Style="{StaticResource ToggleTab}" Margin="0,0,10,0"/>
                    <RadioButton x:Name="FilterShaders" Content="✨ Shaders" Checked="FilterType_Changed" Style="{StaticResource ToggleTab}" Margin="0,0,10,0"/>
                    <RadioButton x:Name="FilterResourcePacks" Content="🎨 Packs" Checked="FilterType_Changed" Style="{StaticResource ToggleTab}" Margin="0,0,10,0"/>
                    
                    <Border Width="1" Height="16" Background="#1E1A2E" Margin="10,0"/>
                    
                    <ToggleButton x:Name="FilterInstalled" Content="📂 Local" Style="{StaticResource ToggleTabButton}" 
                                  Checked="FilterInstalled_Changed" Unchecked="FilterInstalled_Changed" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Background="#100D1A" CornerRadius="12" BorderBrush="#1E1A2E" BorderThickness="1" Height="40" Width="260">
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="14,0" 
                                 KeyDown="SearchBox_KeyDown" FontSize="13" Tag="Buscar..."/>
                        <Button HorizontalAlignment="Right" Content="🔍" Background="Transparent" BorderThickness="0" Foreground="#4A4266" Width="36" Cursor="Hand" Click="BtnSearch_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Display -->
        <Border Grid.Row="1" Background="#0A0815" CornerRadius="20" BorderBrush="#1E1A2E" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- Loading -->
                <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="2" Style="{StaticResource AppleProgress}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="LoadingLabel" Text="Iniciando enlace con Modrinth..." Foreground="#4A4266" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Results -->
                <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Padding="14">
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ContentCard}">
                                    <Grid Margin="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Width="80" Height="80" CornerRadius="18" Background="#0C0A15" Margin="0,0,0,14" BorderBrush="#1E1A2E" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill">
                                                    <Image.OpacityMask>
                                                        <VisualBrush>
                                                            <VisualBrush.Visual>
                                                                <Border Background="Black" CornerRadius="18" Width="80" Height="80"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Image.OpacityMask>
                                                </Image>
                                                <Border Background="#10B981" CornerRadius="10" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-6,-6" 
                                                        Visibility="{Binding IsInstalledVisibility}">
                                                    <TextBlock Text="✓" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="ExtraBold" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Author}" Foreground="#7C3AED" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#6B5E8A" FontSize="11" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" TextAlignment="Center" LineHeight="14"/>
                                            
                                            <Grid Margin="0,12,0,0" Opacity="0.5">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="📥 " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownloadsText}" Foreground="#C4B5FD" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <Button Grid.Row="2" Content="{Binding ButtonLabel}" Style="{StaticResource PremiumBtn}" Background="{Binding ButtonColor}" 
                                                Click="InstallBtn_Click" Tag="{Binding ProjectId}" Height="38" Margin="0,12,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Local Mode -->
                <ScrollViewer x:Name="LocalScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                    <ItemsControl x:Name="LocalList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0C0A15" CornerRadius="12" Margin="0,0,0,8" Padding="14,10" BorderBrush="#1E1A2E" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SizeText}" Foreground="#4A4266" FontSize="10" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="🗑️" Style="{StaticResource SecondaryButton}" Height="30" Width="38" Padding="0" Tag="{Binding FilePath}" Click="DeleteFileBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Feedback States -->
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="🛸" FontSize="36" HorizontalAlignment="Center" Opacity="0.5" Margin="0,0,0,12"/>
                    <TextBlock Text="Vacío Galáctico" Foreground="#4A4266" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Button Content="Reintentar sin filtros" Margin="0,12,0,0" Style="{StaticResource SecondaryButton}" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

