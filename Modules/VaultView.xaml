<UserControl x:Class="NebulaLauncher.Modules.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Inyectamos BoolToVis localmente para máxima seguridad -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#1A1528"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#2E2648"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="360"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="VaultRoot">
        <Grid Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌌 HUB NEBULAR" Foreground="White" FontSize="26" FontWeight="Black"/>
                    <Border Background="#207C3AED" CornerRadius="8" Padding="12,4" Margin="20,0,0,0">
                        <TextBlock Text="MODS &amp; SHADERS" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Button Content="🔄 Actualizar" Margin="20,0,0,0" Style="{DynamicResource SecondaryButton}" Height="32" Click="BtnRefresh_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Cambiado de ModernToggle a ToggleTab -->
                    <RadioButton x:Name="FilterMods" Content="Mods" IsChecked="True" Style="{DynamicResource ToggleTab}" Margin="0,0,8,0" Click="FilterType_Changed"/>
                    <RadioButton x:Name="FilterShaders" Content="Shaders" Style="{DynamicResource ToggleTab}" Margin="0,0,8,0" Click="FilterType_Changed"/>
                    <RadioButton x:Name="FilterResourcePacks" Content="Packs" Style="{DynamicResource ToggleTab}" Margin="0,0,16,0" Click="FilterType_Changed"/>
                    
                    <CheckBox x:Name="FilterInstalled" Content="Instalados" Style="{DynamicResource TrayToggle}" VerticalAlignment="Center" Margin="0,0,16,0" Checked="FilterInstalled_Changed" Unchecked="FilterInstalled_Changed"/>
                    
                    <Border Background="#1A1528" CornerRadius="12" Width="200" BorderBrush="#2E2648" BorderThickness="1" Margin="12,0,0,0">
                        <Grid>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" Padding="14,8,40,8" KeyDown="SearchBox_KeyDown" VerticalContentAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Content="🔍" Background="Transparent" BorderThickness="0" Foreground="#7B6FA0" Width="40" Click="BtnSearch_Click"/>
                        </Grid>
                    </Border>
                    
                    <ComboBox x:Name="SortCombo" Width="140" Style="{DynamicResource ModernComboBox}" Margin="12,0,0,0" SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="Relevancia" Tag="relevance" IsSelected="True"/>
                        <ComboBoxItem Content="Descargas" Tag="downloads"/>
                        <ComboBoxItem Content="Recientes" Tag="newest"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- CUERPO -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Margin="0,0,16,0" Background="#0D0A1ACC" CornerRadius="22" BorderBrush="#1E1A2E" BorderThickness="1">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="CATEGORÍAS" Foreground="#4A4266" FontSize="10" FontWeight="Black" Margin="4,0,0,12"/>
                            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" SelectionChanged="CategoryList_SelectionChanged">
                                <ListBoxItem IsSelected="True" Tag="all"><TextBlock Text="🌌 Todos"/></ListBoxItem>
                                <ListBoxItem Tag="optimization"><TextBlock Text="⚡ Optimización"/></ListBoxItem>
                                <ListBoxItem Tag="technology"><TextBlock Text="🤖 Tecnología"/></ListBoxItem>
                                <ListBoxItem Tag="magic"><TextBlock Text="🔮 Magia"/></ListBoxItem>
                                <ListBoxItem Tag="adventure"><TextBlock Text="🧗 Aventura"/></ListBoxItem>
                            </ListBox>
                        </StackPanel>

                        <Border Grid.Row="2" Background="#0A0714" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="MASA DE MODS" Foreground="#3D3560" FontSize="9" FontWeight="Black" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Local" Foreground="#7B6FA0" FontSize="11"/>
                                    <TextBlock x:Name="TxtTotalWeight" Text="0 MB" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="WeightProgress" Height="4" Value="0" Maximum="1000" Style="{DynamicResource AppleProgress}" Margin="0,4"/>
                                <TextBlock x:Name="TxtWeightStatus" Text="Carga Óptima" Foreground="#10B981" FontSize="9" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- RESULTADOS -->
                <Border Grid.Column="1" Background="#0A0815" CornerRadius="22" BorderBrush="#1E1A2E" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="SkeletonPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" Padding="14">
                            <WrapPanel HorizontalAlignment="Center">
                                <Border Width="250" Height="360" Background="#161125" CornerRadius="18" Margin="12"/>
                                <Border Width="250" Height="360" Background="#161125" CornerRadius="18" Margin="12"/>
                            </WrapPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Padding="14">
                            <StackPanel>
                                <ItemsControl x:Name="ResultsList">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GlassCard}" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                                <Grid Margin="18">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <Border Width="90" Height="90" CornerRadius="24" Background="#161125">
                                                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="50"/>
                                                        <TextBlock Text="{Binding Author}" Foreground="#A78BFA" FontSize="11" HorizontalAlignment="Center" Margin="0,4"/>
                                                        <TextBlock Text="{Binding DownloadsText}" Foreground="#C4B5FD" FontSize="12" HorizontalAlignment="Center" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <Button Grid.Row="2" Content="{Binding ButtonLabel}" Style="{DynamicResource PlayButton}" Background="{Binding ButtonBrush}" Click="InstallBtn_Click" Tag="{Binding ProjectId}" Height="40" Visibility="{Binding ShowButton, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed">
                                    <Button Content="«" Style="{DynamicResource SecondaryButton}" Width="40" Click="BtnPrevPage_Click"/>
                                    <TextBlock x:Name="TxtPage" Text="1" VerticalAlignment="Center" Margin="15,0" Foreground="White" FontWeight="Bold"/>
                                    <Button Content="»" Style="{DynamicResource SecondaryButton}" Width="40" Click="BtnNextPage_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="LocalScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                            <ItemsControl x:Name="LocalList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#161125" CornerRadius="12" Margin="0,0,0,10" Padding="16" BorderBrush="#2E2648" BorderThickness="1">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SizeText}" Foreground="#7B6FA0" FontSize="11"/>
                                                </StackPanel>
                                                <Button HorizontalAlignment="Right" Content="🗑️" Style="{DynamicResource SecondaryButton}" Tag="{Binding FilePath}" Click="DeleteFileBtn_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="🌌" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="Vacío Cósmico" Foreground="#C4B5FD" FontSize="18" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FLYOUT -->
        <Border x:Name="DetailFlyout" Background="#0A0815" BorderBrush="#2E2648" BorderThickness="1,0,0,0" HorizontalAlignment="Right" Width="480" Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform X="480"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Button Margin="20" Content="✕" Style="{DynamicResource TitleBarButton}" Width="32" Click="CloseFlyout_Click" HorizontalAlignment="Left"/>
                <ScrollViewer Grid.Row="1" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Width="80" Height="80" CornerRadius="18" Background="#161125">
                                <Image x:Name="DetailIcon" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock x:Name="DetailTitle" Foreground="White" FontSize="22" FontWeight="Black" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailAuthor" Foreground="#A78BFA" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="#1A1528" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ANÁLISIS DE IMPACTO" Foreground="#7B6FA0" FontSize="9" FontWeight="Black"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock x:Name="TxtImpactIcon" Text="🟢" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtModImpact" Text="Bajo" Foreground="#10B981" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtModWeightEstimate" Text="0 MB" Foreground="#4A4266" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="DetailDescription" Foreground="#D1D5DB" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>