<UserControl x:Class="KrakenLauncher.Modules.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#05080D" Offset="0"/>
            <GradientStop Color="#05080D" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="40,36,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="Rendimiento y Estadísticas"
                       Foreground="White" FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="MÉTRICAS DE HARDWARE Y TIEMPO DE VUELO"
                       Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU CARD -->
                <Border Grid.Column="0" CornerRadius="20" Background="#0A0E14" BorderBrush="#0D151D" BorderThickness="1" Padding="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="CARGA CPU" FontSize="9" Foreground="#344A5B" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CpuValueText" Text="0%" FontSize="32" FontWeight="Bold" Foreground="#FF9500" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- RAM CARD -->
                <Border Grid.Column="2" CornerRadius="20" Background="#0A0E14" BorderBrush="#0D151D" BorderThickness="1" Padding="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💾" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="MEMORIA RAM" FontSize="9" Foreground="#344A5B" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RamValueText" Text="0 MB" FontSize="32" FontWeight="Bold" Foreground="#FF9500" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- STATS CARD (Play Time) -->
                <Border Grid.Column="4" CornerRadius="20" Background="#0A0E14" BorderBrush="#0D151D" BorderThickness="1" Padding="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏱" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="TIEMPO TOTAL" FontSize="9" Foreground="#344A5B" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalPlayTimeText" Text="0h 0m" FontSize="32" FontWeight="Bold" Foreground="#FF9500" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ACTIVITY GRAPH PANEL -->
            <Border Grid.Row="2" Background="#0A0E14" CornerRadius="20" BorderBrush="#0D151D" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="TELEMETRÍA EN VIVO" FontSize="10" FontWeight="Bold" Foreground="#1C2D3A"/>
                        <TextBlock Text="  ·  Consumo de recursos del sistema" FontSize="10" Foreground="#2A2440"/>
                    </StackPanel>

                    <!-- Graph Canvas -->
                    <Canvas Grid.Row="1" x:Name="GraphCanvas" ClipToBounds="True">
                        <Line X1="0" Y1="100" X2="1000" Y2="100" Stroke="#0D151D" StrokeThickness="1" StrokeDashArray="4 2"/>
                        <Line X1="0" Y1="150" X2="1000" Y2="150" Stroke="#0D151D" StrokeThickness="1" StrokeDashArray="4 2"/>
                        <Polyline x:Name="ActivityLine" Stroke="#FF9500" StrokeThickness="3" StrokeLineJoin="Round">
                            <Polyline.Effect>
                                <DropShadowEffect Color="#FF9500" Opacity="0.6" BlurRadius="12" ShadowDepth="0"/>
                            </Polyline.Effect>
                        </Polyline>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
