<UserControl x:Class="NebulaLauncher.Modules.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0714" Offset="0"/>
            <GradientStop Color="#0F0B1A" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,28">

            <!-- Header -->
            <TextBlock Text="Ajustes"
                       Foreground="#F0EAFF" FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="CONFIGURACI\u00D3N DE JUEGO"
                       Foreground="#3D3560" FontSize="9" FontWeight="Bold"
                       Margin="0,0,0,28"/>

            <!-- Instances Config Card -->
            <Border Background="#12101E" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#1A1528" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#7C3AED">
                            <TextBlock Text="\uD83D\uDCC1" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Gesti\u00F3n de Instancias" Foreground="#F0EAFF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="NOMBRE DE INSTANCIA" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstanceNameBox" Style="{DynamicResource AppleTextBox}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Cambiar" Click="BtnChangeInstance_Click" Style="{DynamicResource SecondaryButton}" Height="38" Padding="12,0"/>
                    </Grid>
                    <TextBlock Text="Separa tus mundos y mods usando carpetas aisladas (ej: 'creative', 'survival')." Foreground="#4A4266" FontSize="10" Margin="4,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Server Config Card -->
            <Border Background="#12101E" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#1A1528" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#7C3AED">
                            <TextBlock Text="\uD83C\uDF10" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Conexi\u00F3n al Servidor" Foreground="#F0EAFF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="IP DEL SERVIDOR" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <TextBox x:Name="ServerIpBox" Style="{DynamicResource AppleTextBox}" TextChanged="ServerIpBox_TextChanged" Margin="0,0,0,16"/>

                    <TextBlock Text="PUERTO BLUEMAP" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <TextBox x:Name="BlueMapPortBox" Style="{DynamicResource AppleTextBox}" TextChanged="BlueMapPortBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- App Configuration Card -->
            <Border Background="#12101E" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#1A1528" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#5865F2">
                            <TextBlock Text="\u2699\uFE0F" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ajustes del Launcher" Foreground="#F0EAFF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="ID DEL MAPA (BLUEMAP)" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <TextBox x:Name="MapIdBox" Text="world" Style="{DynamicResource AppleTextBox}" Margin="0,0,0,16" TextChanged="MapIdBox_TextChanged"/>

                    <TextBlock Text="URL DEL WEBHOOK (CRASHES)" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <TextBox x:Name="WebhookBox" Style="{DynamicResource AppleTextBox}" TextChanged="WebhookBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- Memory & Performance Card -->
            <Border Background="#12101E" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#1A1528" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#10B981">
                            <TextBlock Text="\u26A1" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Rendimiento y RAM" Foreground="#F0EAFF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Optimizaci\u00F3n Autom\u00E1tica" Foreground="#F0EAFF" FontSize="13"/>
                            <TextBlock Text="Asigna RAM basada en tu sistema" Foreground="#4A4266" FontSize="10"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Optimizar" Click="BtnAutoOptimize_Click" Style="{DynamicResource SecondaryButton}" Height="32"/>
                    </Grid>

                    <Separator Background="#1A1528" Margin="0,0,0,16"/>

                    <TextBlock Text="AJUSTE MANUAL" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="RamSlider" Minimum="2" Maximum="16" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="RamSlider_ValueChanged" Style="{DynamicResource AppleSlider}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="RamValueText" Text="4" Foreground="#7C3AED" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text=" GB" Foreground="#4A4266" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="RUTA DE JAVA (OPCIONAL)" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="0,16,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="JavaPathBox" Style="{DynamicResource AppleTextBox}" IsReadOnly="True" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="..." Style="{DynamicResource SecondaryButton}" Width="40" Click="BtnBrowseJava_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance Card -->
            <Border Background="#12101E" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#1A1528" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#EC4899">
                            <TextBlock Text="\uD83C\uDFA8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Personalizaci\u00F3n" Foreground="#F0EAFF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="COLOR DE ACENTO" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border x:Name="ColorPurple"  MouseDown="Color_MouseDown" Width="36" Height="36" Tag="#7C3AED" Background="#7C3AED" CornerRadius="18" Margin="0,0,10,0" Cursor="Hand"/>
                        <Border x:Name="ColorBlue"    MouseDown="Color_MouseDown" Width="36" Height="36" Tag="#3B82F6" Background="#3B82F6" CornerRadius="18" Margin="0,0,10,0" Cursor="Hand"/>
                        <Border x:Name="ColorEmerald" MouseDown="Color_MouseDown" Width="36" Height="36" Tag="#10B981" Background="#10B981" CornerRadius="18" Margin="0,0,10,0" Cursor="Hand"/>
                        <Border x:Name="ColorRose"    MouseDown="Color_MouseDown" Width="36" Height="36" Tag="#F43F5E" Background="#F43F5E" CornerRadius="18" Margin="0,0,10,0" Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock Text="TEMAS PREDEFINIDOS" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border x:Name="ThemeNebula"  MouseDown="Theme_MouseDown" Tag="#7C3AED" Width="90" Height="34" Background="#1A1528" BorderBrush="#7C3AED" BorderThickness="2" CornerRadius="8" Margin="0,0,8,0" Cursor="Hand">
                            <TextBlock Text="Nebula" Foreground="#F0EAFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ThemeCrimson" MouseDown="Theme_MouseDown" Tag="#EF4444" Width="90" Height="34" Background="#1A1528" BorderBrush="#2E2648" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0" Cursor="Hand">
                            <TextBlock Text="Crimson" Foreground="#EF4444" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ThemeEmerald" MouseDown="Theme_MouseDown" Tag="#10B981" Width="90" Height="34" Background="#1A1528" BorderBrush="#2E2648" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0" Cursor="Hand">
                            <TextBlock Text="Emerald" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="FONDO DE PANTALLA" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BgPathBox" IsReadOnly="True" Style="{DynamicResource AppleTextBox}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="..." Width="34" Height="38" Style="{DynamicResource SecondaryButton}" Click="BtnBrowseBackground_Click"/>
                            <Button Content="\uD83D\uDDD1" Width="34" Height="38" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Click="BtnResetBackground_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Margin="0,12,0,0" Height="80" CornerRadius="12" BorderBrush="#1A1528" BorderThickness="1" Background="#0A0714" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="BgPreviewImage" Stretch="UniformToFill" Opacity="0.5">
                                <Image.Effect>
                                    <BlurEffect Radius="2"/>
                                </Image.Effect>
                            </Image>
                            <TextBlock Text="PREVISUALIZACI\u00D3N" Foreground="#2A2440" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="PreviewPlaceholderText"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Presets Section -->
            <Border Background="#12101E" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#1A1528" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="MODOS DE JUEGO" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PapaModeBtn" Grid.Column="0" Content="\uD83E\uDD54 Modo Papa" Style="{DynamicResource SecondaryButton}" Height="44" Click="PapaModeBtn_Click"/>
                        <Button x:Name="UltraModeBtn" Grid.Column="2" Content="\uD83D\uDE80 Modo Ultra" Style="{DynamicResource PlayButton}" Height="44" Click="UltraModeBtn_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Shortcuts Section -->
            <Border Background="#12101E" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#1A1528" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ACCESOS R\u00C1PIDOS" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,16"/>
                    <UniformGrid Columns="2">
                        <Button Content="\u2728 Shaders" Click="BtnOpenShaders_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,8" Height="38" ToolTip="Abrir carpeta de Shaders"/>
                        <Button Content="\uD83D\uDCE6 Descargar Shaders" Click="BtnDownloadShaders_Click" Style="{DynamicResource PlayButton}" Margin="4,0,0,8" Height="38" FontSize="10"/>
                        <Button Content="\u2699 Configs" Click="BtnOpenConfigs_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,4,0" Height="38"/>
                        <Button Content="\uD83D\uDCC2 Juego" Click="BtnOpenGame_Click" Style="{DynamicResource SecondaryButton}" Margin="4,0,0,0" Height="38"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Maintenance & Support Card -->
            <Border Background="#12101E" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#1A1528" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#F59E0B">
                            <TextBlock Text="\uD83D\uDEE0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Mantenimiento y Ayuda" Foreground="#F0EAFF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="\u00BFEl juego no arranca o va mal?" Foreground="#4A4266" FontSize="11" Margin="0,0,0,14"/>
                    
                    <UniformGrid Columns="2">
                        <Button Content="\uD83D\uDEE0 Reparar Pack" Click="BtnRepairPack_Click" Style="{DynamicResource PlayButton}" Height="38" Margin="0,0,4,0"/>
                        <Button Content="\uD83D\uDCC2 Ver Crashes" Click="BtnViewCrashes_Click" Style="{DynamicResource SecondaryButton}" Height="38" Margin="4,0,0,0"/>
                    </UniformGrid>
                    
                    <TextBlock Text="\u00A1Cuidado! Reparar el pack borrar\u00E1 los mods para reinstalarlos limpiamente." Foreground="#EF4444" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
