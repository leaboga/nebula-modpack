<UserControl x:Class="KrakenLauncher.Modules.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#05080D" Offset="0"/>
            <GradientStop Color="#05080D" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,28">

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,28">
                <TextBlock Text="Panel de Ajustes"
                           Foreground="White" FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="CONFIGURACIÓN DEL NÚCLEO KRAKEN"
                           Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
            </StackPanel>

            <!-- Instances Config Card -->
            <Border Visibility="Collapsed" Background="#0A0E14" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#0D151D" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#FF9500">
                            <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Gestión de Instancias" Foreground="#E6F9FF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="NOMBRE DE INSTANCIA" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstanceNameBox" Style="{DynamicResource AppleTextBox}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Cambiar" Click="BtnChangeInstance_Click" Style="{DynamicResource SecondaryButton}" Height="38" Padding="12,0" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Eliminar" Click="BtnDeleteInstance_Click" Style="{DynamicResource SecondaryButton}" Foreground="#EF4444" Height="38" Padding="12,0"/>
                    </Grid>
                    <TextBlock Text="Separa tus mundos y mods usando carpetas aisladas (ej: 'creative', 'survival')." Foreground="#344A5B" FontSize="10" Margin="4,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Server Config Card -->
            <Border Background="#0A0E14" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#0D151D" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#FF9500">
                            <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Conexión al Servidor" Foreground="#E6F9FF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="IP DEL SERVIDOR" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <TextBox x:Name="ServerIpBox" Style="{DynamicResource AppleTextBox}" TextChanged="ServerIpBox_TextChanged" Margin="0,0,0,16"/>

                    <TextBlock Text="PUERTO BLUEMAP" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <TextBox x:Name="BlueMapPortBox" Style="{DynamicResource AppleTextBox}" TextChanged="BlueMapPortBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- App Configuration Card -->
            <Border Background="#0A0E14" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#0D151D" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#FF9500">
                            <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ajustes del Launcher" Foreground="#E6F9FF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="ID DEL MAPA (BLUEMAP)" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <TextBox x:Name="MapIdBox" Text="world" Style="{DynamicResource AppleTextBox}" Margin="0,0,0,16" TextChanged="MapIdBox_TextChanged"/>

                    <TextBlock Text="URL DEL WEBHOOK (CRASHES)" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                    <TextBox x:Name="WebhookBox" Style="{DynamicResource AppleTextBox}" TextChanged="WebhookBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- Memory & Performance Card -->
            <Border Background="#0A0E14" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#0D151D" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#FF9500">
                            <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Rendimiento y RAM" Foreground="#E6F9FF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Optimización Automática" Foreground="#E6F9FF" FontSize="13"/>
                            <TextBlock Text="Asigna RAM basada en tu sistema" Foreground="#344A5B" FontSize="10"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Optimizar" Click="BtnAutoOptimize_Click" Style="{DynamicResource SecondaryButton}" Height="32"/>
                    </Grid>

                    <Separator Background="#0D151D" Margin="0,0,0,16"/>

                    <TextBlock Text="AJUSTE MANUAL" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="RamSlider" Minimum="2" Maximum="16" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="RamSlider_ValueChanged" Style="{DynamicResource AppleSlider}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="RamValueText" Text="4" Foreground="#FF9500" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text=" GB" Foreground="#344A5B" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="SELECCIÓN DE JAVA (KRAKEN RUNTIME)" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="0,16,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="JavaVersionCombo" Style="{DynamicResource ModernComboBox}" Margin="0,0,8,0" SelectionChanged="JavaVersionCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Version}" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text=" - " Foreground="#344A5B"/>
                                        <TextBlock Text="{Binding Architecture}" Foreground="#FF9500"/>
                                        <Border Visibility="{Binding IsRecommended, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#2010B981" Margin="8,0,0,0" Padding="4,0" CornerRadius="4">
                                            <TextBlock Text="RECOMENDADO" Foreground="#FF9500" FontSize="8" FontWeight="Black"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="🔄 Scan" Style="{DynamicResource SecondaryButton}" Width="70" Click="BtnRefreshJava_Click"/>
                    </Grid>
                    <TextBlock Text="Detección automática de Javas. Usa v17 o v21 para optimizar el rendimiento." Foreground="#344A5B" FontSize="9" Margin="4,6,0,0"/>

                    <Button Content="📥 Descargar Runtimes Oficiales" Style="{DynamicResource SecondaryButton}" Height="36" Margin="0,16,0,0" Click="BtnDownloadJava_Click"/>
                </StackPanel>
            </Border>

            <!-- ╔═══════════════════════════════════╗ -->
            <!-- ║       CONFIGS DE PEPITA           ║ -->
            <!-- ╚═══════════════════════════════════╝ -->

            <!-- Panel USUARIO: Notificación de configs nuevas -->
            <Border x:Name="PepitaUserPanel" Background="#0A0E14" CornerRadius="16" Padding="24,20" Margin="0,0,0,16"
                    BorderBrush="#FF950030" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="32" Height="32" CornerRadius="9" Background="#FF9500">
                        <TextBlock Text="👑" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Config Oficial del Perfil" Foreground="#E6F9FF" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="SINCRONIZACION RECOMENDADA DEL SERVIDOR" Foreground="#FF9500" FontSize="8" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="#0D1A1F" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="PepitaConfigStatusText"
                                   Text="Verificando estado de configs..."
                                   Foreground="#FFB340" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PepitaConfigHashText"
                                   Text=""
                                   Foreground="#344A5B" FontSize="9" Margin="0,4,0,0" FontFamily="Consolas"/>
                        <TextBlock x:Name="PepitaConfigMetaText"
                                   Text=""
                                   Foreground="#6D8A99" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2">
                    <Button x:Name="BtnAplicarConfigsPepita"
                            Content="⬇ Adaptar Config Oficial"
                            Click="BtnAplicarConfigsPepita_Click"
                            Style="{DynamicResource PlayButton}"
                            Height="40" Margin="0,0,4,0"/>
                    <Button x:Name="BtnVerificarConfigsPepita"
                            Content="🔄 Verificar Cambios"
                            Click="BtnVerificarConfigsPepita_Click"
                            Style="{DynamicResource SecondaryButton}"
                            Height="40" Margin="4,0,0,0"/>
                </UniformGrid>
                <TextBlock Text="La aplicacion es opcional. Si rechazas una revision, no volvera a aparecer hasta que Pepa publique otra nueva."
                           Foreground="#9CAFC0" FontSize="9" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Publicar configs oficiales: visible siempre, protegido por clave admin al hacer click -->
        <Border x:Name="PepitaAdminPanel" Background="#0A0E14" CornerRadius="16" Padding="24,20" Margin="0,0,0,16"
                BorderBrush="#FF950040" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#FF9500">
                        <TextBlock Text="🔒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Publicar Configs Oficiales" Foreground="#E6F9FF" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="PIDE CLAVE ADMIN AL SUBIR" Foreground="#FF9500" FontSize="8" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="#120D1F" CornerRadius="10" Padding="16,12" Margin="0,0,0,14" BorderBrush="#FF950030" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Tus configs actuales (config/, options.txt, shaders y packs) se empaquetaran y subiran como nueva revision oficial." 
                                   Foreground="#FFB340" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Los demas jugadores recibiran un aviso solo si existe una revision superior a la que ya aplicaron o rechazaron."
                                   Foreground="#CC7700" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnPublicarConfigsAdmin"
                        Content="Subir configs oficiales"
                        Click="BtnPublicarConfigsAdmin_Click"
                        Style="{DynamicResource PlayButton}"
                        Height="44"
                        Background="#FF9500"/>

                <Border x:Name="AdminPublishStatusPanel"
                        Background="#0C1320"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,10,0,0"
                        BorderBrush="#FF950030"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="AdminPublishStatusText"
                                       Text="Listo para subir configs."
                                       Foreground="#FFB340"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       DockPanel.Dock="Left"/>
                            <TextBlock x:Name="AdminPublishPercentText"
                                       Text="0%"
                                       Foreground="#FFB340"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar x:Name="AdminPublishProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="8"/>
                        <TextBlock Text="Mantene el launcher abierto hasta que termine la subida."
                                   Foreground="#CC7700"
                                   FontSize="9"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Separator Background="#1A1030" Margin="0,16,0,12"/>

                <TextBlock Text="RESTABLECER CONFIGS EN TU PC" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                <Button x:Name="BtnForzarConfigsPropias"
                        Content="🔄 Re-aplicar Mis Propias Configs (sobreescribir todo)"
                        Click="BtnForzarConfigsPropias_Click"
                        Style="{DynamicResource SecondaryButton}"
                        Height="38"/>
                <TextBlock Text="Útil para restaurar tus configs en una nueva PC."
                           Foreground="#344A5B" FontSize="9" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

    </StackPanel>
    </ScrollViewer>
</UserControl>

