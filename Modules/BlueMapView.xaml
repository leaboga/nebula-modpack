<UserControl x:Class="NebulaLauncher.Modules.BlueMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0714" Offset="0"/>
            <GradientStop Color="#0F0B1A" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="40,36,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Mapa" Foreground="#F0EAFF" FontSize="26" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="MAPA 3D EN TIEMPO REAL (BLUEMAP)" Foreground="#3D3560" FontSize="9" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="ðŸŒ Ver en navegador"
                            Style="{StaticResource SecondaryButton}"
                            Height="36" Padding="14,0" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Click="OpenBrowser_Click"/>
                    <Button Content="â†º Recargar"
                            Style="{StaticResource SecondaryButton}"
                            Height="36" Padding="14,0"
                            VerticalAlignment="Center"
                            Click="ReloadBtn_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- WebView2 -->
        <Border Grid.Row="1" CornerRadius="16" Background="#12101E"
                BorderBrush="#2E2648" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="MapView"/>
                <TextBlock x:Name="LoadingLabel"
                           Text="ðŸ—ºï¸  Cargando BlueMap (paciencia, es pesado)..."
                           Foreground="#4A4266" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
