<UserControl x:Class="KrakenLauncher.Modules.ServerHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#05080D" Offset="0"/>
            <GradientStop Color="#05080D" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,28">
            <!-- Header -->
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="Hostear Servidor"
                           Foreground="White" FontSize="26" FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="GESTIÓN DE NODOS Y GALAXIAS LOCALES"
                           Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Configuration column -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <!-- Installation Card -->
                    <Border Background="#0A0E14" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#0D151D" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="32" Height="32" CornerRadius="9" Background="#00F2FF">
                                    <TextBlock Text="🛠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Configuración del Servidor" Foreground="#E6F9FF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="RUTA DE INSTALACIÓN" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ServerPathBox" Style="{DynamicResource AppleTextBox}" IsReadOnly="True" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="..." Style="{DynamicResource SecondaryButton}" Width="40" Click="BtnBrowseServerPath_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="VERSIÓN DE MINECRAFT" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                                    <ComboBox x:Name="VersionComboBox" Style="{DynamicResource ModernComboBox}" Height="38"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="CARGADOR (LOADER)" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                                    <ComboBox x:Name="LoaderComboBox" Style="{DynamicResource ModernComboBox}" Height="38">
                                        <ComboBoxItem Content="Vanilla" Tag="vanilla" IsSelected="True"/>
                                        <ComboBoxItem Content="Fabric" Tag="fabric"/>
                                        <ComboBoxItem Content="Forge" Tag="forge"/>
                                        <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="MEMORIA RAM (GB)" Foreground="#344A5B" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                             <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RamSlider" Minimum="1" Maximum="32" IsSnapToTickEnabled="True" TickFrequency="1" Value="4" ValueChanged="RamSlider_ValueChanged" Style="{DynamicResource AppleSlider}"/>
                                <TextBlock Grid.Column="1" x:Name="RamValueText" Text="4 GB" Foreground="#00F2FF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Button x:Name="BtnInstall" Content="⚡ INSTALAR SERVIDOR" Style="{DynamicResource PlayButton}" Height="48" Click="BtnInstall_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Control Card -->
                    <Border Background="#0A0E14" CornerRadius="16" Padding="24,20" BorderBrush="#0D151D" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="32" Height="32" CornerRadius="9" Background="#10B981">
                                    <TextBlock Text="🚀" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Control de Ejecución" Foreground="#E6F9FF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnStart" Grid.Column="0" Content="▶ INICIAR" Style="{DynamicResource PlayButton}" Height="44" Margin="0,0,8,0" Click="BtnStart_Click" IsEnabled="False"/>
                                <Button x:Name="BtnStop" Grid.Column="1" Content="⏹ DETENER" Style="{DynamicResource SecondaryButton}" Foreground="#EF4444" Height="44" Margin="8,0,0,0" Click="BtnStop_Click" IsEnabled="False"/>
                            </Grid>
                            
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnOpenFolder" Grid.Column="0" Content="📂 ABRIR CARPETA" Style="{DynamicResource SecondaryButton}" Height="36" Margin="0,0,8,0" Click="BtnOpenFolder_Click"/>
                                <Button x:Name="BtnSyncMods" Grid.Column="1" Content="🔄 SINCRONIZAR MODS" Style="{DynamicResource SecondaryButton}" Height="36" Margin="8,0,0,0" Click="BtnSyncMods_Click"/>
                            </Grid>
                            
                            <CheckBox x:Name="AutoRestartCheck" Content="Auto-reiniciar si falla" Foreground="#6D8A99" FontSize="11" Margin="4,16,0,0" Style="{DynamicResource TrayToggle}"/>
                            <CheckBox x:Name="GuiCheck" Content="Mostrar interfaz original de Minecraft Server" Foreground="#6D8A99" FontSize="11" Margin="4,8,0,0" Style="{DynamicResource TrayToggle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status column -->
                <StackPanel Grid.Column="1">
                    <Border Background="#0A0E14" CornerRadius="16" Padding="20" BorderBrush="#0D151D" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ESTADO" Foreground="#8E8E93" FontSize="9" FontWeight="Bold" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#1C2D3A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="No instalado" Foreground="#E6F9FF" FontSize="14" FontWeight="Bold" Margin="10,0,0,0"/>
                            </StackPanel>
                            
                            <Border Height="1" Background="#0D151D" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="JUGADORES" Foreground="#8E8E93" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="PlayersText" Text="0 / 20" Foreground="#70F9FF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="USO DE CPU" Foreground="#8E8E93" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ProgressBar x:Name="CpuBar" Height="4" Value="0" Style="{DynamicResource AppleProgress}" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="USO DE RAM" Foreground="#8E8E93" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RamText" Text="0 MB / 4 GB" Foreground="#6D8A99" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Right"/>
                            <ProgressBar x:Name="RamBar" Height="4" Value="0" Style="{DynamicResource AppleProgress}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#05080D" CornerRadius="16" Padding="16" BorderBrush="#0D151D" BorderThickness="1" Height="250">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CONSOLA" Foreground="#8E8E93" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" x:Name="ConsoleScroll">
                                <TextBlock x:Name="ConsoleText" Foreground="#10B981" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Text="Esperando inicio..."/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
