<UserControl x:Class="NebulaLauncher.Modules.ServerHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0714" Offset="0"/>
            <GradientStop Color="#0F0B1A" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36,40,28">
            <!-- Header -->
            <TextBlock Text="Hostear Servidor"
                       Foreground="#F0EAFF" FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="CREA TU PROPIA GALAXIA LOCAL"
                       Foreground="#3D3560" FontSize="9" FontWeight="Bold"
                       Margin="0,0,0,28"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Configuration column -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <!-- Installation Card -->
                    <Border Background="#12101E" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" BorderBrush="#1A1528" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="32" Height="32" CornerRadius="9" Background="#7C3AED">
                                    <TextBlock Text="🛠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Configuración del Servidor" Foreground="#F0EAFF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="RUTA DE INSTALACIÓN" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ServerPathBox" Style="{DynamicResource AppleTextBox}" IsReadOnly="True" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="..." Style="{DynamicResource SecondaryButton}" Width="40" Click="BtnBrowseServerPath_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="VERSIÓN DE MINECRAFT" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                                    <ComboBox x:Name="VersionComboBox" Style="{DynamicResource ModernComboBox}" Height="38"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="CARGADOR (LOADER)" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                                    <ComboBox x:Name="LoaderComboBox" Style="{DynamicResource ModernComboBox}" Height="38">
                                        <ComboBoxItem Content="Vanilla" Tag="vanilla" IsSelected="True"/>
                                        <ComboBoxItem Content="Fabric" Tag="fabric"/>
                                        <ComboBoxItem Content="Forge" Tag="forge"/>
                                        <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="MEMORIA RAM (GB)" Foreground="#4A4266" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                             <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RamSlider" Minimum="1" Maximum="32" IsSnapToTickEnabled="True" TickFrequency="1" Value="4" Style="{DynamicResource AppleSlider}"/>
                                <TextBlock Grid.Column="1" x:Name="RamValueText" Text="4 GB" Foreground="#7C3AED" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Button x:Name="BtnInstall" Content="⚡ INSTALAR SERVIDOR" Style="{DynamicResource PlayButton}" Height="48" Click="BtnInstall_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Control Card -->
                    <Border Background="#12101E" CornerRadius="16" Padding="24,20" BorderBrush="#1A1528" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="32" Height="32" CornerRadius="9" Background="#10B981">
                                    <TextBlock Text="🚀" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Control de Ejecución" Foreground="#F0EAFF" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnStart" Grid.Column="0" Content="▶ INICIAR" Style="{DynamicResource PlayButton}" Height="44" Margin="0,0,8,0" Click="BtnStart_Click" IsEnabled="False"/>
                                <Button x:Name="BtnStop" Grid.Column="1" Content="⏹ DETENER" Style="{DynamicResource SecondaryButton}" Foreground="#EF4444" Height="44" Margin="8,0,0,0" Click="BtnStop_Click" IsEnabled="False"/>
                            </Grid>
                            
                            <CheckBox x:Name="AutoRestartCheck" Content="Auto-reiniciar si falla" Foreground="#7B6FA0" FontSize="11" Margin="4,16,0,0" Style="{DynamicResource TrayToggle}"/>
                            <CheckBox x:Name="GuiCheck" Content="Mostrar interfaz original de Minecraft Server" Foreground="#7B6FA0" FontSize="11" Margin="4,8,0,0" Style="{DynamicResource TrayToggle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status column -->
                <StackPanel Grid.Column="1">
                    <Border Background="#12101E" CornerRadius="16" Padding="20" BorderBrush="#1A1528" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ESTADO" Foreground="#3D3560" FontSize="9" FontWeight="Bold" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#3D3560" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="No instalado" Foreground="#F0EAFF" FontSize="14" FontWeight="Bold" Margin="10,0,0,0"/>
                            </StackPanel>
                            
                            <Border Height="1" Background="#1A1528" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="JUGADORES" Foreground="#3D3560" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="PlayersText" Text="0 / 20" Foreground="#A78BFA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="USO DE CPU" Foreground="#3D3560" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ProgressBar x:Name="CpuBar" Height="4" Value="0" Style="{DynamicResource AppleProgress}" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="USO DE RAM" Foreground="#3D3560" FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RamText" Text="0 MB / 4 GB" Foreground="#7B6FA0" FontSize="10" Margin="0,0,0,4" HorizontalAlignment="Right"/>
                            <ProgressBar x:Name="RamBar" Height="4" Value="0" Style="{DynamicResource AppleProgress}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0A0714" CornerRadius="16" Padding="16" BorderBrush="#1A1528" BorderThickness="1" Height="250">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CONSOLA" Foreground="#3D3560" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" x:Name="ConsoleScroll">
                                <TextBlock x:Name="ConsoleText" Foreground="#10B981" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Text="Esperando inicio..."/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
