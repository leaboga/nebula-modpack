<UserControl x:Class="NebulaLauncher.Modules.SocialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0714" Offset="0"/>
            <GradientStop Color="#0F0B1A" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <UserControl.Resources>
        <!-- Slim scrollbar override for this view -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width"      Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#2E2648" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,36,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="Social"
                       Foreground="#F0EAFF" FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="NEBULA LIVE HUB"
                       Foreground="#3D3560" FontSize="9" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Status + Resources -->
            <StackPanel Grid.Column="0">

                <!-- SERVER STATUS CARD -->
                <Border Background="#12101E" CornerRadius="16" Padding="22,18" Margin="0,0,0,14">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2E2648" Offset="0"/>
                            <GradientStop Color="#1A1528" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect Color="#7C3AED" Opacity="0.08" BlurRadius="30" ShadowDepth="0"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="SERVIDOR"
                                   FontSize="9" FontWeight="Bold" Foreground="#3D3560"
                                   Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                     Fill="#EF4444" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#EF4444" Opacity="0.8" BlurRadius="8" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Text="OFFLINE"
                                       FontSize="20" FontWeight="Bold" Foreground="#F0EAFF"
                                       Margin="12,0,0,0"/>
                        </StackPanel>

                        <Border Height="1" Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2E2648" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="EN LÃNEA"
                                   FontSize="9" FontWeight="Bold" Foreground="#3D3560"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="PlayerCountText" Text="0 Jugadores"
                                   FontSize="15" FontWeight="Bold" Foreground="#A78BFA"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="VERSIÃ“N"
                                   FontSize="9" FontWeight="Bold" Foreground="#3D3560"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="VersionText" Text="NeoForge 1.21.1"
                                   FontSize="12" Foreground="#7B6FA0"/>
                    </StackPanel>
                </Border>

                <!-- HOST RESOURCES CARD -->
                <Border Background="#12101E" CornerRadius="16" Padding="22,18">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2E2648" Offset="0"/>
                            <GradientStop Color="#1A1528" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <StackPanel>
                        <TextBlock Text="RECURSOS DEL HOST"
                                   FontSize="9" FontWeight="Bold" Foreground="#3D3560"
                                   Margin="0,0,0,16"/>

                        <!-- CPU -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="#C4B5FD"/>
                            <TextBlock x:Name="CpuText" Text="0%"
                                       FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="#A78BFA"/>
                        </Grid>
                        <ProgressBar x:Name="CpuBar" Height="4" Value="0"
                                     Style="{StaticResource AppleProgress}"
                                     Margin="0,0,0,16"/>

                        <!-- RAM -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="#C4B5FD"/>
                            <TextBlock x:Name="RamText" Text="0 GB"
                                       FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="#A78BFA"/>
                        </Grid>
                        <ProgressBar x:Name="RamBar" Height="4" Value="0"
                                     Style="{StaticResource AppleProgress}"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ACTIVITY FEED -->
            <Border Grid.Column="2" Background="#12101E" CornerRadius="16" Padding="0">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2E2648" Offset="0"/>
                        <GradientStop Color="#1A1528" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" Opacity="0.08" BlurRadius="30" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Feed header -->
                    <Border Grid.Row="0" Padding="22,18,22,14">
                        <Border.BorderBrush><SolidColorBrush Color="#2E2648"/></Border.BorderBrush>
                        <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="âš¡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ACTIVIDAD RECIENTE"
                                       FontSize="9" FontWeight="Bold" Foreground="#7B6FA0"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="CacheBadge" Background="#1A1528" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="CacheLabel" Text="Datos en cachÃ©" Foreground="#4A4266" FontSize="8" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="AdvancementsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="22,14" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#12101E77" CornerRadius="14" Padding="14,12" Margin="0,0,0,10" BorderBrush="#1A1528" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Width="40" Height="40" CornerRadius="10" Background="#0A0714" BorderBrush="#7C3AED44" BorderThickness="1">
                                            <Image Source="{Binding head}" Stretch="Uniform" Margin="4"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding player}" Foreground="#A78BFA" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding text}" Foreground="#F0EAFFCC" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding date}" Foreground="#3D3560" FontSize="10" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
