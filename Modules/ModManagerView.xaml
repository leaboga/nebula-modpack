<UserControl x:Class="KrakenLauncher.Modules.ModManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="40,36,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,28">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Gestión de Sistemas" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ADMINISTRAR COMPONENTES INSTALADOS" Foreground="#8E8E93" FontSize="9" FontWeight="Bold"/>
                    <Border Width="4" Height="4" Background="#1E2C38" CornerRadius="2" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SyncStatusLabel" Text="✓ SINCRONIZADO" Foreground="#10B981" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnSync" Content="🚀 Sincronizar" Style="{DynamicResource SecondaryButton}" Height="34" Width="130" Click="BtnSync_Click" Margin="0,0,10,0"/>
                <Button Content="📁 Abrir Carpeta" Style="{DynamicResource SecondaryButton}" Height="34" Width="140" Click="BtnOpenFolder_Click" Margin="0,0,10,0"/>
                <Button Content="🔄 Refrescar" Style="{DynamicResource SecondaryButton}" Height="34" Width="120" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Margin="0,0,0,16">
            <TextBox x:Name="SearchBox" Style="{DynamicResource SearchTextBox}" Tag="Filtrar por nombre de mod..." TextChanged="SearchBox_TextChanged"/>
        </Border>

        <!-- Mod List Background -->
        <Border Grid.Row="2" Background="#05080D" CornerRadius="22" BorderBrush="#1E2C38" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="ModScroll" VerticalScrollBarVisibility="Auto" Padding="14">
                    <ItemsControl x:Name="ModList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0D151D" CornerRadius="16" Margin="0,0,0,10" Padding="16" BorderBrush="#1F1B2E" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mod Icon Container -->
                                        <Border Width="48" Height="48" CornerRadius="14" Background="#1F1B2E" VerticalAlignment="Center">
                                            <Grid>
                                                <!-- Fallback Default Icon -->
                                                <TextBlock Text="\uD83D\uDCE6" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                                                
                                                <!-- Actual Mod Icon -->
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image.Clip>
                                                        <RectangleGeometry RadiusX="14" RadiusY="14" Rect="0,0,48,48"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SizeText}" Foreground="#344A5B" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="Black" Margin="0,0,16,0" VerticalAlignment="Center" Opacity="0.8"/>
                                            <CheckBox IsChecked="{Binding IsEnabled}" Style="{DynamicResource TrayToggle}" Click="ModToggle_Click" Tag="{Binding FileName}" VerticalAlignment="Center"/>
                                            <Border Width="1" Height="20" Background="#1E2C38" Margin="16,0"/>
                                            <Button Content="\uD83D\uDDD1\uFE0F" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="14" Cursor="Hand" Click="DeleteMod_Click" Tag="{Binding FileName}" ToolTip="Eliminar mod permanentemente"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="\uD83D\uDC7D" FontSize="48" HorizontalAlignment="Center" Opacity="0.2"/>
                    <TextBlock Text="No se encontraron mods" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Usa el Mod Hub para descargar contenido" Foreground="#344A5B" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
