<Window Icon="/nebula.ico"
        x:Class="NebulaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KRAKEN Launcher"
        Height="660" Width="1020"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Closing="Window_Closing">

    <Window.Resources>
        <DropShadowEffect x:Key="CardGlow"   Color="#00F2FF" Opacity="0.12" BlurRadius="30" ShadowDepth="0"/>
        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.4"  BlurRadius="25" ShadowDepth="6"/>
        
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,30,0,0" To="0,0,0,0" Duration="0:0:0.7">
                <ThicknessAnimation.EasingFunction>
                    <PowerEase Power="5" EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
        
        <Storyboard x:Key="PulseEffect">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        
        <Storyboard x:Key="TabChangeEffect">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.4"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="20,0,0,0" To="0,0,0,0" Duration="0:0:0.3">
                <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- MASTER BACKGROUND -->
        <Border Background="#05080D"/>
        
        <!-- GLOW EFFECTS -->
        <Ellipse Fill="#3000F2FF" Width="900" Height="900" Margin="-400,-400,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="200"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="#1500F2FF" Width="600" Height="600" Margin="0,0,-200,-200" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="150"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="Black" Opacity="0.5" IsHitTestVisible="False"/>

        <!-- BACKGROUND IMAGE -->
        <Image x:Name="LauncherBackground" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False">
            <Image.Effect><BlurEffect Radius="15"/></Image.Effect>
        </Image>

        <!-- PARTICLES -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <Grid x:Name="MainRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#081016" Offset="0"/>
                        <GradientStop Color="#05080D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="25" ShadowDepth="4" Direction="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" Width="1" Opacity="0.3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00F2FF" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,38,20,0">
                            <!-- Logo -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                <Border Width="44" Height="44" CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00F2FF" Offset="0"/>
                                            <GradientStop Color="#00B8C2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00F2FF" Opacity="0.6" BlurRadius="20" ShadowDepth="0"/>
                                    </Border.Effect>
                                    <TextBlock Text="🦑" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="KRAKEN" Foreground="White" FontSize="22" FontWeight="Black"/>
                                    <TextBlock Text="THE ABYSSAL TITAN" Foreground="#344A5B" FontSize="9" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ACCOUNT -->
                            <TextBlock Text="PERSONAL" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="8,0,0,12"/>
                            <Border Background="#0A0E14" CornerRadius="12" Padding="12,12" Margin="0,0,0,24" BorderBrush="#0D151D" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                     <Border Width="42" Height="42" CornerRadius="12" ClipToBounds="True">
                                         <Border.Background>
                                             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                 <GradientStop Color="#1E2C38" Offset="0"/>
                                                 <GradientStop Color="#0D151D" Offset="1"/>
                                             </LinearGradientBrush>
                                         </Border.Background>
                                         <Grid>
                                             <TextBlock x:Name="AvatarInitial" Text="?" FontSize="18" FontWeight="Bold" Foreground="#6D8A99" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                             <Image x:Name="SkinImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed"/>
                                             <Ellipse Width="10" Height="10" Fill="#10B981" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" x:Name="ActiveUserDot">
                                                 <Ellipse.Effect><BlurEffect Radius="2"/></Ellipse.Effect>
                                             </Ellipse>
                                         </Grid>
                                     </Border>
                                     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                         <TextBlock x:Name="SidebarUsername" Text="KRAKEN Pilot" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                         <TextBlock x:Name="SidebarAuthType" Text="Cuenta Conectada" Foreground="#344A5B" FontSize="10"/>
                                     </StackPanel>
                                 </StackPanel>
                            </Border>

                            <!-- NAVIGATION -->
                            <TextBlock Text="OPERACIONES" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Black" Margin="14,0,0,12"/>
                            
                            <RadioButton Content="Centro de Mando" Style="{DynamicResource ToggleTab}" GroupName="Nav" IsChecked="True" Checked="Nav_Home_Checked"/>
                            <RadioButton Content="Biblioteca de Mods" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_ModHub_Checked"/>
                            <RadioButton Content="Administrar Mods" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_ModManager_Checked"/>
                            <RadioButton Content="Modpack Hub" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_Modpacks_Checked"/>
                            <RadioButton Content="Comunidad" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_Social_Checked"/>

                            <Border Height="1" Margin="4,20,4,20" Background="{DynamicResource BorderBrush}"/>

                            <TextBlock Text="SERVICIOS" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Black" Margin="14,0,0,12"/>
                            <RadioButton Content="Deep Map" Style="{DynamicResource ToggleTab}" GroupName="Nav" x:Name="NavBlueMap" Checked="Nav_BlueMap_Checked"/>
                            <RadioButton Content="Servidor Local" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_LocalHost_Checked"/>
                            <RadioButton Content="Infraestructura" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_Hosting_Checked"/>
                            <RadioButton Content="Diagnóstico" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_Crash_Checked"/>
                            <RadioButton Content="Rendimiento" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_Perf_Checked"/>
                            <RadioButton Content="Novedades" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_Changelog_Checked"/>

                            <Border Height="1" Margin="4,24,4,24" Background="{DynamicResource BorderBrush}"/>

                            <!-- SERVER STATUS (Integrated) -->
                            <Border Style="{DynamicResource GlassPanel}" Background="#0A0E14" Padding="14,12" Margin="4,0,4,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusText" Text="DESCONECTADO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Black" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PlayersText" Text="Sin datos de red" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="16,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="CopyIpBtn" Content="Copiar Dirección IP" Style="{DynamicResource SecondaryButton}" Height="36" Click="CopyIpBtn_Click" Margin="4,0,4,24"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="20,0,20,20">
                        <Border Background="#0A0E14" CornerRadius="10" Padding="12,10" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MÉTRICAS" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Black" Margin="0,0,0,8"/>
                                <Grid>
                                    <TextBlock x:Name="TotalTimeLabel" Text="0h 0m" Foreground="White" FontSize="12" FontWeight="Black"/>
                                    <TextBlock x:Name="SessionCountLabel" Text="0 SESIONES" Foreground="{DynamicResource AccentBrush}" FontSize="8" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="UpdateBadge" Text="CORE UPDATE PENDING" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Black" Cursor="Hand" Visibility="Collapsed" MouseDown="UpdateBadge_Click" Margin="4,0,0,8"/>
                        <TextBlock x:Name="VersionFooterLabel" Text="KRAKEN ENGINE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Black" Margin="4,0,0,0"/>

                        <StackPanel x:Name="AdminPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="ADMINISTRACIÓN" Foreground="#FF4B4B" FontSize="8" FontWeight="Black" Margin="4,0,0,8"/>
                            <Button Content="Publicar Motor Core" Style="{DynamicResource SecondaryButton}" Height="32" Click="PublicarLauncher_Click" Margin="0,0,0,6"/>
                            <Button Content="Publicar Assets/Mods" Style="{DynamicResource SecondaryButton}" Height="32" Click="PublicarActualizacion_Click" Margin="0,0,0,6"/>
                        </StackPanel>
                        <Button x:Name="MusicToggle" Content="🎵" FontSize="13" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0,-22,0,0" Opacity="0.4" Cursor="Hand" Click="MusicToggle_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN PANEL -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/> <!-- Titlebar -->
                    <RowDefinition Height="60"/> <!-- Context Header -->
                    <RowDefinition Height="*"/>  <!-- Content Area -->
                    <RowDefinition Height="120"/> <!-- Bottom Action Bar -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button Content="—" Style="{DynamicResource TitleBarButton}" Click="MinimizeButton_Click"/>
                        <Button Content="🗖" Style="{DynamicResource TitleBarButton}" Click="ToggleMaximize_Click" ToolTip="Maximizar/Restaurar"/>
                        <Button Content="✕" Style="{DynamicResource TitleBarButton}" Click="CloseButton_Click" x:Name="MainCloseBtn"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Context Header (Breadcrumbs/Status) -->
                <Grid Grid.Row="1" Margin="32,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CurrentViewLabel" Text="CENTRO DE COMANDO" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Black" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Border Width="1" Height="10" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ActiveProfileLabel" Text="Perfil Predeterminado" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ViewTitleLabel" Text="Bienvenido al Abismo" Foreground="White" FontSize="20" FontWeight="Black" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 3. Content Area -->
                <Grid Grid.Row="2" Margin="32,4,32,0">
                    <Border Style="{DynamicResource GlassPanel}">
                        <Grid ClipToBounds="True">
                             <!-- HOME VIEW -->
                            <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                                <StackPanel Margin="32,24">
                                    <TextBlock Text="Sincronización de Sistemas en curso..." Foreground="#344A5B" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="HomeGreetingLabel" Text="Comandante en el Deck" Foreground="White" FontSize="32" FontWeight="Black" Margin="0,0,0,24"/>

                                    <!-- PROFILE SELECTOR -->
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="PERFIL ACTIVO" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="2,0,0,10"/>
                                            <ComboBox x:Name="ProfileComboBox" Height="38" Style="{DynamicResource ModernComboBox}" SelectionChanged="ProfileComboBox_SelectionChanged"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="📋 Clonar" Width="90" Style="{DynamicResource SecondaryButton}" Height="38" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="CloneProfile_Click"/>
                                        <Button Grid.Column="2" Content="➕ Nuevo Perfil" Width="100" Style="{DynamicResource SecondaryButton}" Height="38" VerticalAlignment="Bottom" Click="NewProfile_Click"/>
                                    </Grid>

                                    <!-- NEWS CARD (Unified) -->
                                    <Border Style="{DynamicResource GlassCard}" Margin="0,0,0,28" Background="#0D151D88" Padding="24">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Border Background="#10B981" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,12" x:Name="LiveNewsBadge">
                                                    <TextBlock Text="ESTADO: ESTABLE" Foreground="White" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                                <TextBlock Text="Motores Abisales Listos" Foreground="White" FontSize="22" FontWeight="Black" Margin="0,0,0,4"/>
                                                <TextBlock Text="El ecosistema KRAKEN está optimizado para la versión actual. Todos los sistemas de red funcionan dentro de los parámetros esperados." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="500"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="50" Height="50" CornerRadius="10" Background="#1A00F2FF" VerticalAlignment="Center">
                                                <TextBlock Text="⚓" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- MAP QUICK ACCESS -->
                                    <Border Background="#0D151D99" CornerRadius="8" Padding="20,16" Margin="0,0,0,24" BorderBrush="#1E2C38" BorderThickness="1" Cursor="Hand" MouseDown="MapQuickCard_MouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" CornerRadius="12" Background="#207C3AED">
                                                <TextBlock Text="🌍" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Detección de Flota (Live Map)" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="Rastrea la posición de otras unidades en el Abismo." Foreground="#6D8A99" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="➜" Foreground="#00F2FF" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- CONFIG -->
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="MODO DE SESIÓN" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="2,0,0,10"/>
                                            <Border Background="#05080D" CornerRadius="12" Padding="4" HorizontalAlignment="Left" BorderBrush="#0D151D" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="OfflineToggle" Content="Offline" Style="{DynamicResource ToggleTab}" IsChecked="True" GroupName="Mode" Checked="AuthToggle_Changed" Padding="16,6"/>
                                                    <RadioButton x:Name="PremiumToggle" Content="Premium" Style="{DynamicResource ToggleTab}" GroupName="Mode" Checked="AuthToggle_Changed" Padding="16,6"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="VERSIÓN DEL PACK" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="2,0,0,10"/>
                                            <ComboBox x:Name="VersionComboBox" Height="36" Style="{DynamicResource ModernComboBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="OfflinePanel" Visibility="Visible">
                                        <TextBlock Text="NOMBRE DE PILOTO" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                                        <TextBox x:Name="NickTextBox" Style="{DynamicResource AppleTextBox}" Height="40" VerticalContentAlignment="Center" TextChanged="NickTextBox_TextChanged"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PremiumPanel" Visibility="Collapsed">
                                        <StackPanel x:Name="NotLoggedPanel">
                                            <Button x:Name="MicrosoftLoginButton" Content="Conectar con Microsoft" Style="{DynamicResource SecondaryButton}" Height="44" Click="MicrosoftLoginButton_Click"/>
                                        </StackPanel>
                                        <StackPanel x:Name="LoggedPanel" Visibility="Collapsed">
                                            <Border Background="#05080D" CornerRadius="12" Padding="16,10" BorderBrush="#1E2C38" BorderThickness="1">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="CUENTA PREMIUM" Foreground="#10B981" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <TextBlock x:Name="LoggedUsernameText" Text="Usuario" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Button Content="Cerrar" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Height="30" Padding="12,0" Click="LogoutButton_Click"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,28,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ASIGNACIÓN DE RAM" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="RamLabel" Text="8 GB" Foreground="#00F2FF" FontSize="14" FontWeight="Black"/>
                                    </Grid>
                                    <Slider x:Name="RamSlider" Minimum="2" Maximum="16" Value="8" Style="{DynamicResource AppleSlider}" ValueChanged="RamSlider_ValueChanged"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- SKELETON LOADING OVERLAY (Reusable) -->
                            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#05080D">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="60" Height="60" Style="{DynamicResource SkeletonBlock}" CornerRadius="30" Margin="0,0,0,20"/>
                                    <Border Width="120" Height="10" Style="{DynamicResource SkeletonBlock}" Margin="0,0,0,8"/>
                                    <Border Width="80" Height="8" Style="{DynamicResource SkeletonBlock}" Opacity="0.5"/>
                                </StackPanel>
                            </Grid>

                            <!-- MODULES -->
                            <ContentControl x:Name="ModulesContainer" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. BOTTOM ACTION BAR (Refined) -->
                <Grid Grid.Row="3" Margin="32,20,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Console/Diagnostic -->
                    <Border Grid.Column="0" Background="#0A0E14" CornerRadius="12" BorderBrush="#1E2C38" BorderThickness="1" Margin="0,0,20,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="TELEMETRÍA DE SISTEMAS" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Black"/>
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ScrollViewer x:Name="LogScroll" Grid.Row="1">
                                <TextBlock x:Name="LogText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Opacity="0.8"/>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ProgressLabel" Text="SISTEMA LISTO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="PercentageLabel" Text="" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Black" Margin="10,0,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="CPU" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CpuPerfText" Text="0%" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Width="1" Height="10" Background="#1E2C38" Margin="12,0"/>
                                    <TextBlock Text="RAM" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RamPerfText" Text="0 MB" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Play Section -->
                    <StackPanel Grid.Column="1">
                        <Button x:Name="PlayButton" Content="INICIAR SECUENCIA" Style="{DynamicResource PlayButton}" Height="56" Click="PlayButton_Click" FontSize="15"/>
                        <Grid Margin="4,12,4,0">
                            <CheckBox x:Name="TrayToggle" Content="Segundo Plano" Style="{DynamicResource TrayToggle}" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed"/>
                            <CheckBox x:Name="TurboToggle" Content="Modo Turbo" Style="{DynamicResource TrayToggle}" HorizontalAlignment="Right" Checked="TurboToggle_Changed" Unchecked="TurboToggle_Changed"/>
                        </Grid>
                    </StackPanel>
                    
                    <ProgressBar x:Name="MainProgressBar" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="3" Style="{DynamicResource AppleProgress}" Margin="0,0,0,-8"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
