<Window Icon="/kraken.ico"
        x:Class="KrakenLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KRAKEN Launcher"
        Height="660" Width="1020"
        MinHeight="540" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <DropShadowEffect x:Key="CardGlow"   Color="#18E0D2" Opacity="0.10" BlurRadius="18" ShadowDepth="0"/>
        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.32" BlurRadius="16" ShadowDepth="4"/>
        
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,14,0,0" To="0,0,0,0" Duration="0:0:0.24">
                <ThicknessAnimation.EasingFunction>
                    <PowerEase Power="5" EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
        
        <Storyboard x:Key="PulseEffect">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        
        <Storyboard x:Key="TabChangeEffect">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:0.14"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="10,0,0,0" To="0,0,0,0" Duration="0:0:0.16">
                <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- MASTER BACKGROUND -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#000000" Offset="0"/>
                    <GradientStop Color="#1C1C1E" Offset="0.48"/>
                    <GradientStop Color="#000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        
        <!-- GLOW EFFECTS -->
        <Ellipse Fill="#150A84FF" Width="760" Height="760" Margin="-340,-360,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="#100A84FF" Width="520" Height="520" Margin="0,0,-170,-170" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect>
        </Ellipse>
        <Rectangle Fill="#22000000" IsHitTestVisible="False"/>

        <!-- BACKGROUND IMAGE -->
        <Image x:Name="LauncherBackground" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False">
            <Image.Effect><BlurEffect Radius="15"/></Image.Effect>
        </Image>

        <!-- PARTICLES -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <Grid x:Name="MainRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000000" Offset="0"/>
                        <GradientStop Color="#1C1C1E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="25" ShadowDepth="4" Direction="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" Width="1" Opacity="0.3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00F2FF" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,38,20,0">
                            <!-- Logo -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                <Border Width="44" Height="44" CornerRadius="12" Background="Transparent">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00F2FF" Opacity="0.4" BlurRadius="15" ShadowDepth="0"/>
                                    </Border.Effect>
                                    <Image Source="/Assets/logo_premium.png" Width="44" Height="44" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="KRAKEN" Foreground="White" FontSize="24" FontWeight="Black" FontFamily="{StaticResource DisplayFont}"/>
                                    <TextBlock Text="ABYSSAL ENGINE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Black"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ACCOUNT -->
                            <TextBlock Text="PERSONAL" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="8,0,0,12"/>
                            <Border Background="#1C1C1E" CornerRadius="12" Padding="12,12" Margin="0,0,0,24" BorderBrush="#38383A" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                     <Border Width="42" Height="42" CornerRadius="12" ClipToBounds="True">
                                         <Border.Background>
                                             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                 <GradientStop Color="#1E2C38" Offset="0"/>
                                                 <GradientStop Color="#0D151D" Offset="1"/>
                                             </LinearGradientBrush>
                                         </Border.Background>
                                         <Grid>
                                             <TextBlock x:Name="AvatarInitial" Text="?" FontSize="18" FontWeight="Bold" Foreground="#6D8A99" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                             <Image x:Name="SkinImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed"/>
                                             <Ellipse Width="10" Height="10" Fill="#10B981" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" x:Name="ActiveUserDot">
                                                 <Ellipse.Effect><BlurEffect Radius="2"/></Ellipse.Effect>
                                             </Ellipse>
                                         </Grid>
                                     </Border>
                                     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                         <TextBlock x:Name="SidebarUsername" Text="Jugador" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                         <TextBlock x:Name="SidebarAuthType" Text="Cuenta Conectada" Foreground="#344A5B" FontSize="10"/>
                                     </StackPanel>
                                 </StackPanel>
                            </Border>

                            <!-- NAVIGATION -->
                            <TextBlock Text="OPERACIONES" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Black" Margin="14,0,0,12"/>
                            
                            <RadioButton x:Name="NavHome" Content="Inicio" Style="{DynamicResource ToggleTab}" GroupName="Nav" IsChecked="True" Checked="Nav_Home_Checked"/>
                            
                            <RadioButton x:Name="NavSistemas" Content="Sistema" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_Sistemas_Checked">
                                <RadioButton.ToolTip>
                                    <ToolTip Content="Ajustes crticos, sincronizacin oficial, rendimiento y consola." Background="#1C1C1E" Foreground="White" BorderBrush="#0A84FF"/>
                                </RadioButton.ToolTip>
                            </RadioButton>

                            <RadioButton Content="Biblioteca Mod" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_Recursos_Checked">
                                <RadioButton.ToolTip>
                                    <ToolTip Content="Descarga mods, gestiona tus archivos locales y explora modpacks." Background="#1C1C1E" Foreground="White" BorderBrush="#0A84FF"/>
                                </RadioButton.ToolTip>
                            </RadioButton>

                            <RadioButton Content="Servidor" Style="{DynamicResource ToggleTab}" GroupName="Nav" Checked="Nav_Red_Checked">
                                <RadioButton.ToolTip>
                                    <ToolTip Content="Social, Servidores, Mapa en Vivo y Capturas de pantalla." Background="#1C1C1E" Foreground="White" BorderBrush="#0A84FF"/>
                                </RadioButton.ToolTip>
                            </RadioButton>

                            <Border Height="1" Margin="4,24,4,24" Background="{DynamicResource BorderBrush}"/>

                            <!-- SERVER STATUS (Integrated) -->
                            <Border Style="{DynamicResource GlassPanel}" Background="#1C1C1E" Padding="14,12" Margin="4,0,4,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusText" Text="DESCONECTADO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Black" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PlayersText" Text="Sin datos de red" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="16,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="CopyIpBtn" Content="Copiar Dirección IP" Style="{DynamicResource SecondaryButton}" Height="36" Click="CopyIpBtn_Click" Margin="4,0,4,24"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="20,0,20,20">
                        <Border Background="#1C1C1E" CornerRadius="10" Padding="12,10" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MÉTRICAS" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Black" Margin="0,0,0,8"/>
                                <Grid>
                                    <TextBlock x:Name="TotalTimeLabel" Text="0h 0m" Foreground="White" FontSize="12" FontWeight="Black"/>
                                    <TextBlock x:Name="SessionCountLabel" Text="0 SESIONES" Foreground="{DynamicResource AccentBrush}" FontSize="8" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="UpdateBadge" Text="CORE: ACTUALIZACIÓN PENDIENTE" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Black" Cursor="Hand" Visibility="Collapsed" MouseDown="UpdateBadge_Click" Margin="4,0,0,8"/>
                        <TextBlock x:Name="VersionFooterLabel" Text="KRAKEN ENGINE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Black" Margin="4,0,0,0"/>

                        <StackPanel x:Name="AdminPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="ADMINISTRACIÓN" Foreground="#FF4B4B" FontSize="8" FontWeight="Black" Margin="4,0,0,8"/>
                            <Button Content="Subir Configs Oficiales" Style="{DynamicResource SecondaryButton}" Height="32" Click="OpenConfigAdmin_Click" Margin="0,0,0,6"/>
                            <Button Content="Publicar Motor Core" Style="{DynamicResource SecondaryButton}" Height="32" Click="PublicarLauncher_Click" Margin="0,0,0,6"/>
                            <Button Content="Publicar Assets/Mods" Style="{DynamicResource SecondaryButton}" Height="32" Click="PublicarActualizacion_Click" Margin="0,0,0,6"/>
                        </StackPanel>
                        <Button x:Name="MusicToggle" Content="" FontSize="13" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0,-22,0,0" Opacity="0.4" Cursor="Hand" Click="MusicToggle_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN PANEL -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/> <!-- Titlebar -->
                    <RowDefinition Height="60"/> <!-- Context Header -->
                    <RowDefinition Height="*"/>  <!-- Content Area -->
                    <RowDefinition x:Name="ActionBarRow" Height="120"/> <!-- Bottom Action Bar -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource TitleBarButton}" Click="MinimizeButton_Click"/>
                        <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource TitleBarButton}" Click="ToggleMaximize_Click" ToolTip="Maximizar/Restaurar"/>
                        <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource TitleBarButton}" Click="CloseButton_Click" x:Name="MainCloseBtn"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Context Header (Breadcrumbs/Status) -->
                <Grid Grid.Row="1" Margin="32,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CurrentViewLabel" Text="CENTRO DE COMANDO" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Black" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.5"/>
                            
                            <StackPanel Orientation="Horizontal" x:Name="ActiveProfileInfo">
                                <TextBlock x:Name="ActiveProfileLabel" Text="Perfil Predeterminado" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Background="#1A00F2FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActiveVersionLabel" Text="---" Foreground="#0A84FF" FontSize="9" FontWeight="Black"/>
                                </Border>
                                <Border Background="#1A10B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActiveLoaderLabel" Text="---" Foreground="#10B981" FontSize="9" FontWeight="Black"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="ViewTitleLabel" Text="Panel principal" Foreground="White" FontSize="20" FontWeight="Black" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 3. Content Area -->
                <Grid Grid.Row="2" Margin="32,4,32,0">
                    <Border Style="{DynamicResource GlassPanel}">
                        <Grid ClipToBounds="True">
                             <!-- HOME VIEW -->
                            <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                                <StackPanel Margin="32,24">
                                    <TextBlock Text="Estado del ecosistema, perfiles y entrada al servidor." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="HomeGreetingLabel" Text="Listo para jugar" Foreground="White" FontSize="34" FontWeight="Black" FontFamily="{StaticResource DisplayFont}" Margin="0,0,0,24"/>

                                    <!-- PROFILE SELECTOR -->
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="PERFIL ACTIVO" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="2,0,0,10"/>
                                            <ComboBox x:Name="ProfileComboBox" Height="38" Style="{DynamicResource ModernComboBox}" SelectionChanged="ProfileComboBox_SelectionChanged"/>
                                            <TextBlock x:Name="ProfileModeLabel" Text="---" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Black" Margin="4,6,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="4,6,0,0" Opacity="0.5">
                                                <TextBlock Text="RUTA: " Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Black"/>
                                                <TextBlock x:Name="ProfilePathLabel" Text="---" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content=" Clonar" Width="90" Style="{DynamicResource SecondaryButton}" Height="38" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="CloneProfile_Click"/>
                                        <Button Grid.Column="2" Content=" Nuevo Perfil" Width="100" Style="{DynamicResource SecondaryButton}" Height="38" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="NewProfile_Click"/>
                                        <Button Grid.Column="3" x:Name="DeleteProfileButton" Content="Eliminar" Width="88" Style="{DynamicResource SecondaryButton}" Foreground="#EF4444" Height="38" VerticalAlignment="Bottom" Click="DeleteProfile_Click"/>
                                    </Grid>

                                    <!-- NEWS CARD (Unified) -->
                                    <Border Style="{DynamicResource GlassCard}" Margin="0,0,0,28" Background="#0D151D88" Padding="24">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Border Background="#10B981" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,12" x:Name="LiveNewsBadge">
                                                    <TextBlock Text="ESTADO: ESTABLE" Foreground="White" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                                <TextBlock Text="Instancia lista" Foreground="White" FontSize="22" FontWeight="Black" Margin="0,0,0,4"/>
                                                <TextBlock Text="Perfil, mods y configuraciones listos para iniciar. Revisa actualizaciones antes de jugar." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="500"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="50" Height="50" CornerRadius="10" Background="#1A00F2FF" VerticalAlignment="Center">
                                                <TextBlock Text="" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- MAP QUICK ACCESS -->
                                    <Border Background="#0D151D99" CornerRadius="8" Padding="20,16" Margin="0,0,0,24" BorderBrush="#38383A" BorderThickness="1" Cursor="Hand" MouseDown="MapQuickCard_MouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" CornerRadius="12" Background="#207C3AED">
                                                <TextBlock Text="" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Detección de Flota (Live Map)" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="Abre el mapa del servidor y revisa la actividad." Foreground="#6D8A99" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="" Foreground="#0A84FF" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- CONFIG -->
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="MODO DE SESIÓN" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="2,0,0,10"/>
                                            <Border Background="#05080D" CornerRadius="12" Padding="4" HorizontalAlignment="Left" BorderBrush="#38383A" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="OfflineToggle" Content="Offline" Style="{DynamicResource ToggleTab}" IsChecked="True" GroupName="Mode" Checked="AuthToggle_Changed" Padding="16,6"/>
                                                    <RadioButton x:Name="PremiumToggle" Content="Premium" Style="{DynamicResource ToggleTab}" GroupName="Mode" Checked="AuthToggle_Changed" Padding="16,6"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock x:Name="VersionComboTitle" Text="VERSION" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="2,0,0,10"/>
                                            <ComboBox x:Name="VersionComboBox" Height="36" Style="{DynamicResource ModernComboBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="LOADER" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="2,0,0,10"/>
                                            <ComboBox x:Name="ProfileLoaderCombo" Height="36" Style="{DynamicResource ModernComboBox}" SelectionChanged="ProfileLoaderCombo_SelectionChanged">
                                                <ComboBoxItem Content="Vanilla" Tag="vanilla"/>
                                                <ComboBoxItem Content="Fabric" Tag="fabric"/>
                                                <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                                                <ComboBoxItem Content="Forge" Tag="forge"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="OfflinePanel" Visibility="Visible">
                                        <TextBlock Text="NOMBRE DE USUARIO" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" Margin="2,0,0,8"/>
                                        <TextBox x:Name="NickTextBox" Style="{DynamicResource AppleTextBox}" Height="40" VerticalContentAlignment="Center" TextChanged="NickTextBox_TextChanged"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PremiumPanel" Visibility="Collapsed">
                                        <StackPanel x:Name="NotLoggedPanel">
                                            <Button x:Name="MicrosoftLoginButton" Content="Conectar con Microsoft" Style="{DynamicResource SecondaryButton}" Height="44" Click="MicrosoftLoginButton_Click"/>
                                        </StackPanel>
                                        <StackPanel x:Name="LoggedPanel" Visibility="Collapsed">
                                            <Border Background="#05080D" CornerRadius="12" Padding="16,10" BorderBrush="#38383A" BorderThickness="1">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="CUENTA PREMIUM" Foreground="#10B981" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <TextBlock x:Name="LoggedUsernameText" Text="Usuario" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Button Content="Cerrar" HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}" Height="30" Padding="12,0" Click="LogoutButton_Click"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,28,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ASIGNACIÓN DE RAM" Foreground="#1C2D3A" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="RamLabel" Text="8 GB" Foreground="#0A84FF" FontSize="14" FontWeight="Black"/>
                                    </Grid>
                                    <Slider x:Name="RamSlider" Minimum="2" Maximum="16" Value="8" Style="{DynamicResource AppleSlider}" ValueChanged="RamSlider_ValueChanged"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- SKELETON LOADING OVERLAY (Reusable) -->
                            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#05080D">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="60" Height="60" Style="{DynamicResource SkeletonBlock}" CornerRadius="30" Margin="0,0,0,20"/>
                                    <Border Width="120" Height="10" Style="{DynamicResource SkeletonBlock}" Margin="0,0,0,8"/>
                                    <Border Width="80" Height="8" Style="{DynamicResource SkeletonBlock}" Opacity="0.5"/>
                                </StackPanel>
                            </Grid>

                            <!-- MODULES -->
                            <ContentControl x:Name="ModulesContainer" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. BOTTOM ACTION BAR (Refined) -->
                <Grid Grid.Row="3" Margin="32,20,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Console/Diagnostic -->
                    <Border Grid.Column="0" Background="#1C1C1E" CornerRadius="12" BorderBrush="#38383A" BorderThickness="1" Margin="0,0,20,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="ESTADO DEL LAUNCHER" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Black"/>
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ScrollViewer x:Name="LogScroll" Grid.Row="1">
                                <TextBlock x:Name="LogText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Opacity="0.8"/>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ProgressLabel" Text="SISTEMA LISTO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="PercentageLabel" Text="" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Black" Margin="10,0,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="CPU" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CpuPerfText" Text="0%" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Width="1" Height="10" Background="#1E2C38" Margin="12,0"/>
                                    <TextBlock Text="RAM" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RamPerfText" Text="0 MB" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Play Section -->
                    <StackPanel Grid.Column="1">
                        <Button x:Name="PlayButton" Content="INICIAR SECUENCIA" Style="{DynamicResource PlayButton}" Height="58" Click="PlayButton_Click" FontSize="16"/>
                        <Grid Margin="4,12,4,0">
                            <CheckBox x:Name="TrayToggle" Content="Segundo Plano" Style="{DynamicResource TrayToggle}" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed"/>
                            <CheckBox x:Name="TurboToggle" Content="Modo Turbo" Style="{DynamicResource TrayToggle}" HorizontalAlignment="Right" Checked="TurboToggle_Changed" Unchecked="TurboToggle_Changed"/>
                        </Grid>
                    </StackPanel>
                    
                    <ProgressBar x:Name="MainProgressBar" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="3" Style="{DynamicResource AppleProgress}" Margin="0,0,0,-8"/>
                </Grid>
            </Grid>
        </Grid>
        
        <!-- NOTIFICATION AREA -->
        <StackPanel x:Name="NotificationArea" VerticalAlignment="Bottom" HorizontalAlignment="Right" IsHitTestVisible="False" Margin="0,0,20,130"/>

        <!-- TUTORIAL / DISCOVERY OVERLAY -->
        <Grid x:Name="TutorialOverlay" Visibility="Collapsed" Background="#D905080D">

            <!-- Focus Hole (Visual cue) -->
            <Canvas x:Name="TutorialFocusCanvas" IsHitTestVisible="False">
                <Path Fill="#A605080D">
                    <Path.Data>
                         <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <RectangleGeometry Rect="0,0,2000,2000"/>
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <RectangleGeometry x:Name="TutorialFocusRect" Rect="0,0,0,0"/>
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </Path.Data>
                </Path>
            </Canvas>

            <Border x:Name="TutorialCard" VerticalAlignment="Top" HorizontalAlignment="Left" Width="380" Background="#0D151D" CornerRadius="20" BorderBrush="#00F2FF" BorderThickness="1" Padding="24">
                <Border.Effect><DropShadowEffect Color="#00F2FF" BlurRadius="40" Opacity="0.3" ShadowDepth="0"/></Border.Effect>
                <Grid>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="TutorialTitle" Text="Bienvenido al Abismo" Foreground="White" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                            <Button x:Name="BtnCloseTutorial" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource TitleBarButton}" Width="30" Height="30" Click="BtnSkipTutorial_Click"/>
                        </Grid>
                        
                        <TextBlock x:Name="TutorialContent" Text="Estamos listos para sincronizar tus sistemas. ¿Quieres un recorrido rápido por las nuevas funciones?" Foreground="#6D8A99" FontSize="13" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,20"/>
                        
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StepIndicator" Text="Paso 1 de 4" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnSkipTutorial" Content="Omitir" Style="{DynamicResource SecondaryButton}" Padding="12,4" Height="32" Click="BtnSkipTutorial_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnNextTutorial" Content="Entendido" Style="{DynamicResource PlayButton}" Width="100" Height="32" Click="BtnNextTutorial_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
