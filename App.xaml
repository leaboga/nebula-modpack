<Application x:Class="NebulaLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Restaurar el recurso del Icono de Bandeja -->
            <tb:TaskbarIcon x:Key="TrayIcon"
                            IconSource="/nebula.ico"
                            ToolTipText="Nebula Launcher">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Abrir Launcher" Click="TrayOpen_Click"/>
                        <Separator/>
                        <MenuItem Header="Salir" Click="TrayExit_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
