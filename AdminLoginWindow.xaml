<Window x:Class="NebulaLauncher.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin" Height="180" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F2F2F7"
        FontFamily="Segoe UI">
    <StackPanel Margin="28,24">
        <TextBlock Text="Ingresá la clave de administrador"
                   Foreground="#1C1C1E"
                   FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,14"/>
        <PasswordBox x:Name="ClaveBox"
                     Height="40"
                     FontSize="14"
                     Padding="10,0"
                     KeyDown="ClaveBox_KeyDown"/>
        <Button Content="Confirmar"
                Height="38"
                Margin="0,12,0,0"
                Background="#0071E3"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="Confirmar_Click"/>
    </StackPanel>
</Window>
