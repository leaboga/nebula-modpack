<Window x:Class="KrakenLauncher.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Access" Height="180" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#05080D"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <StackPanel Margin="28,24">
        <TextBlock Text="Ingrese la clave de administrador"
                   Foreground="#E6F9FF"
                   FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,14"/>
        <PasswordBox x:Name="ClaveBox"
                     Height="40"
                     FontSize="14"
                     Padding="10,0"
                     KeyDown="ClaveBox_KeyDown"
                     Background="#0D151D"
                     Foreground="White"/>
        <Button Content="Confirmar"
                Height="38"
                Margin="0,12,0,0"
                Style="{DynamicResource PlayButton}"
                Click="Confirmar_Click"/>
    </StackPanel>
</Window>
